<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net9.0-android;net9.0-ios;net9.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net9.0-windows10.0.19041.0</TargetFrameworks>
		<!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
		<!-- <TargetFrameworks>$(TargetFrameworks);net9.0-tizen</TargetFrameworks> -->

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>Kirokuu</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- MVVMTK0045: partial property source generation ez da MAUI Android/iOS-en aplikatzen (AOT-en partial properties oraindik ez dira erabilgarriak guztiz); abisua kentzen dugu. -->
		<!-- XC0045: Source={x:Reference Orri}, Path=BindingContext.X eredua ezin da konpilatu (BindingContext object da); runtime fallback erabiltzen da. -->
		<NoWarn>$(NoWarn);MVVMTK0045;XC0045</NoWarn>

		<!-- XAMLC bindings Source= dutenei tipo-egiaztapena konpilazio-denboran (XC0025). -->
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

		<!-- Display name -->
		<ApplicationTitle>Kirokuu</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.kirokuu</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App ikonoa: Images/kiroku_logo.webp (berdina irekitze pantailan) -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\Images\kiroku_logo.webp" Color="#512BD4" />

		<!-- Splash: hasierako pantaila natiboa (lehenago dotnet_bot/splash.svg zen) -->
		<MauiSplashScreen Include="Resources\Images\kiroku_logo.webp" Color="#000000" BaseSize="256,256" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw: turso_garapena.env build-garaian gehitzen da (Ikusi TursoGarapenaEnvPrestatu). -->
		<MauiAsset Include="Resources\Raw\**" Exclude="Resources\Raw\turso_garapena.env" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="9.1.1" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="LiveChartsCore.SkiaSharpView.Maui" Version="2.0.0-rc2" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.8" />
		<PackageReference Include="Plugin.Maui.Audio" Version="4.0.0" />
		<PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.2" />
		<!-- sqlite-net-pcl-ek SQLitePCLRaw.bundle_green ekartzen du; nativeak bakarra e_sqlcipher izan dadin. -->
		<PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.2">
			<IncludeAssets>none</IncludeAssets>
			<ExcludeAssets>all</ExcludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="SQLitePCLRaw.lib.e_sqlite3.android" Version="2.1.2">
			<IncludeAssets>none</IncludeAssets>
			<ExcludeAssets>all</ExcludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Kirokuu.Zerbitzuak\Kirokuu.Zerbitzuak.csproj" />
	</ItemGroup>

	<PropertyGroup>
		<KiroRepoInguruneBidea>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\.env'))</KiroRepoInguruneBidea>
	</PropertyGroup>

	<Target Name="TursoGarapenaEnvPrestatu" BeforeTargets="ProcessMauiAssets" Condition="$([System.String]::Copy('$(TargetFramework)').Contains('-android'))">
		<PropertyGroup>
			<_TursoGarapenaHelbidea>$(MSBuildThisFileDirectory)Resources\Raw\turso_garapena.env</_TursoGarapenaHelbidea>
		</PropertyGroup>
		<Copy Condition="'$(Configuration)'=='Debug' And Exists('$(KiroRepoInguruneBidea)')" SourceFiles="$(KiroRepoInguruneBidea)" DestinationFiles="$(_TursoGarapenaHelbidea)" SkipUnchangedFiles="true" />
		<Delete Condition="'$(Configuration)'!='Debug'" Files="$(_TursoGarapenaHelbidea)" ContinueOnError="true" />
		<ItemGroup Condition="'$(Configuration)'=='Debug' And Exists('$(_TursoGarapenaHelbidea)')">
			<MauiAsset Include="$(_TursoGarapenaHelbidea)">
				<LogicalName>turso_garapena.env</LogicalName>
				<Link>turso_garapena.env</Link>
			</MauiAsset>
		</ItemGroup>
	</Target>
	<Target Name="GarbitzeanTursoGarapenaEnv" AfterTargets="Clean">
		<Delete Files="$(MSBuildThisFileDirectory)Resources\Raw\turso_garapena.env" ContinueOnError="true" />
	</Target>

</Project>
