<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ered="clr-namespace:Kirokuu.DatuBasea.Ereduak"
             xmlns:kiro="clr-namespace:Kirokuu"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:kontrolak="clr-namespace:Kirokuu.Controls"
             x:Class="Kirokuu.Controls.TxartelXehetasunGastuZerrendaView"
             x:Name="Eskema">
    <VerticalStackLayout Spacing="8">
        <Label Text="Gastu lerroak"
               Style="{StaticResource SubHeadline}" />
        <CollectionView ItemsSource="{Binding GastuLerroak, Source={x:Reference Eskema}}">
            <CollectionView.EmptyView>
                <kontrolak:HutsikIkuspegia Mezua="Ez dago gastu lerroirik." />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="ered:GastuLerroa">
                    <Border Style="{StaticResource TxartelTxartelaEstiloa}"
                            Padding="12"
                            Margin="0,4">
                        <VerticalStackLayout Spacing="5">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Text="{Binding GastuDataFormateatua}"
                                       FontAttributes="Bold"
                                       FontSize="13" />
                                <Label Grid.Column="1"
                                       Text="{Binding ZenbatekoaGuztira, StringFormat='{0:N2} €'}"
                                       FontAttributes="Bold"
                                       FontSize="15"
                                       TextColor="{AppThemeBinding Light={StaticResource EstekaNagusiaArgia}, Dark={StaticResource EstekaNagusiaIluna}}" />
                            </Grid>
                            <Label Text="{Binding GarraioBidea, StringFormat='Garraioa: {0}'}"
                                   FontSize="12"
                                   IsVisible="{Binding GarraioBidea, Converter={toolkit:IsStringNotNullOrEmptyConverter}}" />
                            <Label Text="{Binding Kilometroak, StringFormat='Kilometroak: {0:N0} km'}"
                                   FontSize="12"
                                   IsVisible="{Binding KilometroakIkagarri}" />
                            <Label Text="{Binding Oharrak}"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource TestuBigarrenMailaArgia}, Dark={StaticResource TestuBigarrenMailaIluna}}"
                                   IsVisible="{Binding Oharrak, Converter={toolkit:IsStringNotNullOrEmptyConverter}}" />
                            <Label Text="Ibilgailua erabili da"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource EgoeraOnartuaAtzekoa}"
                                   IsVisible="{Binding IbilgailuaBeharrezkoaBai}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentView>
