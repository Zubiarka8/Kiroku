<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:kontrolak="clr-namespace:Kirokuu.Controls"
             x:Class="Kirokuu.Controls.TxartelXehetasunHeroaView"
             x:Name="Eskema">
    <Border Style="{StaticResource TxartelTxartelaEstiloa}"
            Padding="20,20">
        <VerticalStackLayout Spacing="6"
                             HorizontalOptions="Center">
            <kontrolak:EgoeraBandarenView Egoera="{Binding Egoera, Source={x:Reference Eskema}}"
                                         HorizontalOptions="Center" />
            <Label Text="{Binding Helmuga, Source={x:Reference Eskema}}"
                   FontAttributes="Bold"
                   FontSize="22"
                   HorizontalTextAlignment="Center" />
            <Label Text="{Binding Zenbatekoa, Source={x:Reference Eskema}, StringFormat='{0:N2} €'}"
                   FontAttributes="Bold"
                   FontSize="34"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource EstekaNagusiaArgia}, Dark={StaticResource EstekaNagusiaIluna}}" />
            <Label Text="{Binding DataTestua, Source={x:Reference Eskema}}"
                   FontSize="14"
                   HorizontalTextAlignment="Center"
                   IsVisible="{Binding DataTestua, Source={x:Reference Eskema}, Converter={StaticResource TestuaDagoConverter}}"
                   TextColor="{AppThemeBinding Light={StaticResource TestuBigarrenMailaArgia}, Dark={StaticResource TestuBigarrenMailaIluna}}" />
        </VerticalStackLayout>
    </Border>
</ContentView>
