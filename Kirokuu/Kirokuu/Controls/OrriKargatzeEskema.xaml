<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Kirokuu.Controls.OrriKargatzeEskema"
             x:Name="Eskema">
    <Grid RowDefinitions="Auto,Auto,*"
          RowSpacing="8">
        <ActivityIndicator Grid.Row="0"
                           IsRunning="{Binding IsKargatzean, Source={x:Reference Eskema}}"
                           IsVisible="{Binding IsKargatzean, Source={x:Reference Eskema}}"
                           HorizontalOptions="Center" />
        <Label Grid.Row="1"
               Text="{Binding ErroreMezua, Source={x:Reference Eskema}}"
               Style="{StaticResource ErroreEtiketaEstiloa}"
               IsVisible="{Binding ErroreMezua, Source={x:Reference Eskema}, Converter={toolkit:IsStringNotNullOrEmptyConverter}}" />
        <ContentPresenter Grid.Row="2"
                        Content="{Binding Edukia, Source={x:Reference Eskema}}" />
    </Grid>
</ContentView>
