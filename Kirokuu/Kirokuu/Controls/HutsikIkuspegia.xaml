<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:kiro="clr-namespace:Kirokuu"
             x:Class="Kirokuu.Controls.HutsikIkuspegia"
             x:Name="Eskema">
    <VerticalStackLayout Padding="24"
                         Spacing="12"
                         VerticalOptions="Center">
        <Label Style="{StaticResource IkonoHandiaEstiloa}"
               Text="{x:Static kiro:IkonoFontIturria.HutsikIkonoGlifoa}" />
        <Label Text="{Binding Mezua, Source={x:Reference Eskema}}"
               HorizontalTextAlignment="Center"
               Style="{StaticResource TestuBigarrenMailaEstiloa}" />
    </VerticalStackLayout>
</ContentView>
