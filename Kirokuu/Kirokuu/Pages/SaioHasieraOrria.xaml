<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kirokuu.ViewModels"
             xmlns:kiro="clr-namespace:Kirokuu"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Kirokuu.Pages.SaioHasieraOrria"
             x:DataType="vm:SaioHasieraViewModel"
             Title="Saioa hasi">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing"
                                        Command="{Binding AgertzenDeneanCommand}" />
    </ContentPage.Behaviors>

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">
            <ActivityIndicator IsRunning="{Binding IsKargatzean}"
                               IsVisible="{Binding IsKargatzean}"
                               HorizontalOptions="Center" />

            <Image x:Name="SaioHasieraLogoa"
                   Source="kiroku_logo.webp"
                   Aspect="AspectFit"
                   HeightRequest="132"
                   WidthRequest="132"
                   HorizontalOptions="Center"
                   SemanticProperties.Description="Kirokuu aplikazioaren logoa" />

            <Label Text="Kirokuu"
                   Style="{StaticResource Headline}"
                   HorizontalOptions="Center" />

            <Label Text="Saioa hasi"
                   Style="{StaticResource SubHeadline}"
                   HorizontalOptions="Center" />

            <VerticalStackLayout Spacing="6">
                <Label Text="Posta elektronikoa"
                       Style="{StaticResource EremuEtiketaEstiloa}" />
                <Border Style="{StaticResource SaioSarreraEremuaEstiloa}">
                    <Entry x:Name="PostaSarrera"
                           Style="{StaticResource SaioSarreraEntryEstiloa}"
                           Text="{Binding Posta}"
                           Placeholder="izena@adibidea.eus"
                           Keyboard="Email"
                           SemanticProperties.Hint="Posta elektronikoa" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="Pasahitza"
                       Style="{StaticResource EremuEtiketaEstiloa}" />
                <Border Style="{StaticResource SaioSarreraEremuaEstiloa}">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="0"
                          VerticalOptions="Center">
                        <Entry x:Name="PasahitzaSarrera"
                               Grid.Column="0"
                               Style="{StaticResource SaioSarreraEntryEstiloa}"
                               Text="{Binding Pasahitza}"
                               Placeholder="Pasahitza"
                               IsPassword="{Binding PasahitzaMaskaratuta}"
                               SemanticProperties.Hint="Pasahitza" />
                        <ImageButton x:Name="PasahitzaBegiTekla"
                                     Grid.Column="1"
                                     Source="{Binding PasahitzaBegiarenIrudiarenIzena}"
                                     Command="{Binding AlderantzikatuPasahitzaMaskaCommand}"
                                     Style="{StaticResource SaioIkonoLaguntzaTeklaEstiloa}"
                                     SemanticProperties.Description="{Binding PasahitzaBegiarenDeskribapena}" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <Label Text="{Binding ErroreMezua}"
                   Style="{StaticResource ErroreEtiketaEstiloa}"
                   IsVisible="{Binding ErroreMezua, Converter={toolkit:IsStringNotNullOrEmptyConverter}}" />

            <Button x:Name="SaioaHasiTekla"
                    Text="Sartu"
                    Command="{Binding SaioaHasiCommand}"
                    IsEnabled="{Binding KontuaBlokeatuta, Converter={toolkit:InvertedBoolConverter}}"
                    Margin="0,8,0,0" />

            <Label Text="{Binding BlokeoKontadorea, StringFormat='Desblokeatzeko: {0}'}"
                   HorizontalTextAlignment="Center"
                   FontSize="13"
                   IsVisible="{Binding BlokeoKontadoraIkagarri}" />

            <Button x:Name="ErregistroJoanTekla"
                    Text="Kontua sortu"
                    Command="{Binding JoanErregistoraCommand}"
                    Style="{StaticResource BotoiBigarrenMailakoaEstiloa}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
