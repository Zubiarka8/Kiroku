<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kirokuu.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Kirokuu.Pages.SaioHasieraOrria"
             x:DataType="vm:SaioHasieraViewModel"
             Title="Saioa hasi">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing"
                                        Command="{Binding AgertzenDeneanCommand}" />
    </ContentPage.Behaviors>

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <ActivityIndicator IsRunning="{Binding IsKargatzean}"
                               IsVisible="{Binding IsKargatzean}"
                               HorizontalOptions="Center" />

            <Label Text="Kirokuu"
                   Style="{StaticResource Headline}"
                   HorizontalOptions="Center" />

            <Label Text="Saioa hasi"
                   Style="{StaticResource SubHeadline}"
                   HorizontalOptions="Center" />

            <Entry x:Name="PostaSarrera"
                   Text="{Binding Posta}"
                   Placeholder="Posta"
                   Keyboard="Email"
                   SemanticProperties.Hint="Posta elektronikoa" />

            <Entry x:Name="PasahitzaSarrera"
                   Text="{Binding Pasahitza}"
                   Placeholder="Pasahitza"
                   IsPassword="True"
                   SemanticProperties.Hint="Pasahitza" />

            <Label Text="{Binding ErroreMezua}"
                   TextColor="{AppThemeBinding Light=#B00020, Dark=#FF8A80}"
                   HorizontalTextAlignment="Center" />

            <Button x:Name="SaioaHasiTekla"
                    Text="Sartu"
                    Command="{Binding SaioaHasiCommand}" />

            <Button x:Name="ErregistroJoanTekla"
                    Text="Kontua sortu"
                    Command="{Binding JoanErregistoraCommand}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                    TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
