<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kirokuu.ViewModels"
             x:Class="Kirokuu.Pages.ErabiltzaileBerriaOrria"
             x:DataType="vm:ErabiltzaileBerriaViewModel"
             Title="Langile berria">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14">
            <ActivityIndicator IsRunning="{Binding IsKargatzean}"
                               IsVisible="{Binding IsKargatzean}"
                               HorizontalOptions="Center" />

            <Label Text="Langile kontua sortu (administratzailea)"
                   Style="{StaticResource Headline}"
                   HorizontalTextAlignment="Center" />

            <Entry Text="{Binding Izena}" Placeholder="Izena" />
            <Entry Text="{Binding Abizena}" Placeholder="Abizena" />
            <Entry Text="{Binding Abizena2}" Placeholder="Bigarren abizena" />
            <Entry Text="{Binding Dni}" Placeholder="DNI / NAN" />

            <Label Text="Sektorea" FontAttributes="Bold" />
            <Picker ItemsSource="{Binding SektoreenAukerak}"
                    ItemDisplayBinding="{Binding Etiketa}"
                    SelectedItem="{Binding HautatutakoSektorea}"
                    Title="Aukeratu sektorea" />

            <Label Text="Kargoa" FontAttributes="Bold" />
            <Picker ItemsSource="{Binding KargoenAukerak}"
                    ItemDisplayBinding="{Binding Etiketa}"
                    SelectedItem="{Binding HautatutakoKargoa}"
                    Title="Aukeratu kargoa" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                <Entry Grid.Column="0"
                       Text="{Binding Posta}"
                       Placeholder="Posta"
                       Keyboard="Email" />
                <Button Grid.Column="1"
                        Text="@"
                        Command="{Binding TxertaturikArobaCommand}"
                        FontSize="16"
                        Padding="12,0"
                        WidthRequest="48"
                        HeightRequest="44"
                        VerticalOptions="Center" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                <Entry Grid.Column="0"
                       Text="{Binding Pasahitza}"
                       Placeholder="Pasahitza (min. 8)"
                       IsPassword="{Binding PasahitzaMaskaratuta}" />
                <ImageButton Grid.Column="1"
                             Source="{Binding PasahitzaBegiarenIrudiarenIzena}"
                             Command="{Binding AlderantzikatuPasahitzaMaskaCommand}"
                             BackgroundColor="Transparent"
                             WidthRequest="44"
                             HeightRequest="44"
                             Aspect="AspectFit"
                             SemanticProperties.Description="{Binding PasahitzaBegiarenDeskribapena}" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                <Entry Grid.Column="0"
                       Text="{Binding PasahitzaBerretsi}"
                       Placeholder="Pasahitza berretsi"
                       IsPassword="{Binding PasahitzaBerretsiMaskaratuta}" />
                <ImageButton Grid.Column="1"
                             Source="{Binding PasahitzaBerretsiBegiarenIzena}"
                             Command="{Binding AlderantzikatuPasahitzaBerretsiMaskaCommand}"
                             BackgroundColor="Transparent"
                             WidthRequest="44"
                             HeightRequest="44"
                             Aspect="AspectFit"
                             SemanticProperties.Description="{Binding PasahitzaBerretsiBegiarenDeskribapena}" />
            </Grid>

            <Label Text="{Binding ErroreMezua}"
                   TextColor="{AppThemeBinding Light=#B00020, Dark=#FF8A80}"
                   HorizontalTextAlignment="Center" />

            <Button Text="Sortu langilea"
                    Command="{Binding GordeCommand}"
                    SemanticProperties.Hint="Langile berria sortu" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
