<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kirokuu.ViewModels"
             xmlns:datu="clr-namespace:Kirokuu.DatuEreduak"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:kiro="clr-namespace:Kirokuu"
             x:Class="Kirokuu.Pages.LangileZerrendaOrria"
             x:Name="LangileZerrendaOrriOrokorra"
             x:DataType="vm:LangileZerrendaViewModel"
             Title="Erabiltzaileak">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Berria"
                     Command="{Binding LangileBerriaIrekiCommand}"
                     IsEnabled="{Binding DaIdazketaSarbidea}"
                     Order="Primary"
                     Priority="0" />
    </ContentPage.ToolbarItems>

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing"
                                        Command="{Binding AgertzenDeneanCommand}" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="0" RowSpacing="0">
        <ActivityIndicator Grid.Row="0"
                           IsRunning="{Binding IsKargatzean}"
                           IsVisible="{Binding IsKargatzean}"
                           HorizontalOptions="Center"
                           Margin="0,12" />

        <Label Grid.Row="1"
               Text="{Binding ErroreMezua}"
               Style="{StaticResource ErroreEtiketaEstiloa}"
               Margin="16,8" />

        <SearchBar x:Name="LangileenBilaketa"
                   Grid.Row="2"
                   Placeholder="Bilatu izen, abizen edo posta..."
                   Text="{Binding BilaketaTestua, Mode=TwoWay}"
                   Margin="8,0" />

        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding Langileak}"
                        Margin="8,0"
                        VerticalScrollBarVisibility="Always">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="24" Spacing="12" VerticalOptions="Center">
                    <Label Style="{StaticResource IkonoHandiaEstiloa}"
                           Text="{x:Static kiro:IkonoFontIturria.HutsikIkonoGlifoa}" />
                    <Label Text="{Binding HutsaMezua}"
                           HorizontalTextAlignment="Center"
                           Style="{StaticResource TestuBigarrenMailaEstiloa}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="datu:ErabiltzaileLaburpena">
                    <Border Style="{StaticResource TxartelTxartelaEstiloa}" Padding="12,8" Margin="6,4">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={x:Reference LangileZerrendaOrriOrokorra}, Path=BindingContext.IrekiEkintzakCommand, x:DataType={x:Null}}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4">
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="{Binding Izena}" FontAttributes="Bold" />
                                <Label Text="{Binding Abizena}" FontAttributes="Bold" />
                            </HorizontalStackLayout>
                            <!-- CEO (IsIkusketaSoilik) ikuspegian, gai ilunean testua zuria; argian eta administratzailearen ikuspegian kolore arruntak mantentzen dira. -->
                            <Label Text="{Binding Posta}"
                                   FontSize="13"
                                   FontFamily="OpenSansRegular">
                                <Label.Style>
                                    <Style TargetType="Label">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TestuBigarrenMailaArgia}, Dark={StaticResource TestuBigarrenMailaIluna}}" />
                                        <Style.Triggers>
                                            <DataTrigger TargetType="Label"
                                                         Binding="{Binding Source={x:Reference LangileZerrendaOrriOrokorra}, Path=BindingContext.IsIkusketaSoilik, x:DataType={x:Null}}"
                                                         Value="True">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TestuBigarrenMailaArgia}, Dark={StaticResource White}}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Label.Style>
                            </Label>
                            <HorizontalStackLayout Spacing="8">
                                <Border Padding="8,2"
                                        StrokeThickness="0"
                                        BackgroundColor="{AppThemeBinding Light=#E8EAF6, Dark=#2A2D45}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding RolaTestua}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           FontFamily="OpenSansRegular">
                                        <Label.Style>
                                            <Style TargetType="Label">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light=#3949AB, Dark=#9FA8DA}" />
                                                <Style.Triggers>
                                                    <DataTrigger TargetType="Label"
                                                                 Binding="{Binding Source={x:Reference LangileZerrendaOrriOrokorra}, Path=BindingContext.IsIkusketaSoilik, x:DataType={x:Null}}"
                                                                 Value="True">
                                                        <Setter Property="TextColor" Value="{AppThemeBinding Light=#3949AB, Dark={StaticResource White}}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Label.Style>
                                    </Label>
                                </Border>
                                <Label Text="{Binding AktiboTestua}"
                                       FontSize="12"
                                       VerticalOptions="Center"
                                       FontFamily="OpenSansRegular">
                                    <Label.Style>
                                        <Style TargetType="Label">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />
                                            <Style.Triggers>
                                                <DataTrigger TargetType="Label"
                                                             Binding="{Binding Source={x:Reference LangileZerrendaOrriOrokorra}, Path=BindingContext.IsIkusketaSoilik, x:DataType={x:Null}}"
                                                             Value="True">
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource White}}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Label.Style>
                                </Label>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
