<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kirokuu.ViewModels"
             xmlns:datu="clr-namespace:Kirokuu.DatuEreduak"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             xmlns:measure="clr-namespace:LiveChartsCore.Measure;assembly=LiveChartsCore"
             x:Class="Kirokuu.Pages.AdministratzaileHasieraOrria"
             x:DataType="vm:AdministratzaileHasieraViewModel"
             Title="Hasiera">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing"
                                        Command="{Binding AgertzenDeneanCommand}" />
    </ContentPage.Behaviors>

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <ActivityIndicator IsRunning="{Binding IsKargatzean}"
                               IsVisible="{Binding IsKargatzean}"
                               HorizontalOptions="Center" />

            <Label Text="{Binding OngiEtorriTestua}"
                   Style="{StaticResource Headline}"
                   HorizontalTextAlignment="Center" />

            <Label Text="{Binding LaburpenBurua}"
                   FontSize="14"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource TestuBigarrenMailaArgia}, Dark={StaticResource TestuBigarrenMailaIluna}}" />

            <Label Text="{Binding ErroreMezua}"
                   Style="{StaticResource ErroreEtiketaEstiloa}" />

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Border Grid.Column="0" Style="{StaticResource TxartelTxartelaEstiloa}" Padding="12">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Langileak"
                               FontSize="12"
                               Style="{StaticResource TestuTxartelBuruaEstiloa}" />
                        <Label Text="{Binding LangileKopuruTestua}"
                               FontSize="16"
                               FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource TxartelTxartelaEstiloa}" Padding="12">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Onartutako gastuak (org.)"
                               FontSize="12"
                               Style="{StaticResource TestuTxartelBuruaEstiloa}" />
                        <Label Text="{Binding OnartutakoGastuenTestua}"
                               FontSize="16"
                               FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource TxartelTxartelaEstiloa}" Padding="12">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Zain (org.)"
                               FontSize="12"
                               Style="{StaticResource TestuTxartelBuruaEstiloa}" />
                        <Label Text="{Binding ZainTxartelenTestua}"
                               FontSize="16"
                               FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Label Text="Azken 6 hilabeteetako onartutako gastua (org.)"
                   Style="{StaticResource TituluAtalaEstiloa}"
                   Margin="0,8,0,0" />
            <lvc:CartesianChart HeightRequest="260"
                                Series="{Binding HilabetekoGastuSerieak}"
                                XAxes="{Binding HilabetekoXArdatzak}" />

            <VerticalStackLayout Spacing="4" Margin="0,8,0,0">
                <Label Text="Onartutako gastua kategoriaren arabera (org.)"
                       Style="{StaticResource TituluAtalaEstiloa}" />
                <Label Text="Organizazio osoko onartutako txartelen gastua kategoriaka banatuta (handienak lehenean; gehienez 8)."
                       FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource GrafikoEtiketaArgia}, Dark={StaticResource GrafikoEtiketaIluna}}" />
            </VerticalStackLayout>

            <Label Text="Oraindik ez dago erakusteko daturik onartutako gasturik kategoriaka (organizazioan)."
                   IsVisible="{Binding ErakutsiKategoriaHutsikMezua}"
                   FontSize="13"
                   Margin="0,4,0,0"
                   TextColor="{AppThemeBinding Light={StaticResource GrafikoBigarrenEtiketaArgia}, Dark={StaticResource GrafikoBigarrenEtiketaIluna}}" />

            <Border Style="{StaticResource TxartelTxartelaEstiloa}"
                    Padding="14"
                    IsVisible="{Binding ErakutsiKategoriaBakarra}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Kategoria bakarra"
                           FontAttributes="Bold"
                           FontSize="13"
                           Style="{StaticResource TestuTxartelBuruaEstiloa}" />
                    <Label Text="{Binding KategoriaBakarXehetasuna}"
                           FontSize="15" />
                </VerticalStackLayout>
            </Border>

            <lvc:PieChart IsVisible="{Binding ErakutsiKategoriaPieGrafikoa}"
                          HeightRequest="{OnIdiom Phone=300, Default=300}"
                          Series="{Binding KategoriaGastuSerieak}"
                          TooltipTextSize="12"
                          LegendPosition="Hidden"
                          InitialRotation="-90" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding KategoriaLegendaElementuak}"
                                 IsVisible="{Binding ErakutsiKategoriaPieGrafikoa}"
                                 Spacing="6"
                                 Margin="4,4,4,0">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="datu:KategoriaLegendaElementua">
                        <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="10" Padding="0,2">
                            <Border Grid.Column="0"
                                    WidthRequest="14"
                                    HeightRequest="14"
                                    VerticalOptions="Center"
                                    StrokeThickness="0"
                                    BackgroundColor="{Binding Kolorea}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="3" />
                                </Border.StrokeShape>
                            </Border>
                            <Label Grid.Column="1"
                                   Text="{Binding Izena}"
                                   FontSize="13"
                                   VerticalOptions="Center"
                                   LineBreakMode="TailTruncation"
                                   TextColor="{AppThemeBinding Light={StaticResource TestuBigarrenMailaArgia}, Dark={StaticResource TestuBigarrenMailaIluna}}" />
                            <Label Grid.Column="2"
                                   Text="{Binding Xehetasuna}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="End" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <lvc:CartesianChart IsVisible="{Binding ErakutsiKategoriaBarraGrafikoa}"
                                HeightRequest="{OnIdiom Phone=340, Default=300}"
                                Series="{Binding KategoriaBarraSerieak}"
                                XAxes="{Binding KategoriaBarraXArdatzak}"
                                YAxes="{Binding KategoriaBarraYArdatzak}" />

            <Label Text="Txartelak egoeraren arabera (org.)"
                   Style="{StaticResource TituluAtalaEstiloa}"
                   Margin="0,8,0,0" />
            <lvc:CartesianChart HeightRequest="260"
                                Series="{Binding EgoeraSerieak}"
                                XAxes="{Binding EgoeraXArdatzak}"
                                YAxes="{Binding EgoeraYArdatzak}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
