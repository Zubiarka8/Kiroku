<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kirokuu.ViewModels"
             xmlns:datu="clr-namespace:Kirokuu.DatuBasea.Ereduak"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Kirokuu.Pages.LangileaTxartelaXehetasunOrria"
             x:DataType="vm:LangileaTxartelaXehetasunViewModel"
             Title="Txartel xehetasunak">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <ActivityIndicator IsRunning="{Binding IsKargatzean}"
                               IsVisible="{Binding IsKargatzean}"
                               HorizontalOptions="Center" />

            <Label Text="{Binding ErroreMezua}"
                   TextColor="{AppThemeBinding Light=#B00020, Dark=#FF8A80}"
                   HorizontalTextAlignment="Center"
                   IsVisible="{Binding ErroreMezua, Converter={toolkit:IsStringNotNullOrEmptyConverter}}" />

            <!-- Status badge -->
            <Border Padding="10,6" StrokeShape="RoundRectangle 8" HorizontalOptions="Start">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding Egoera}" Value="Zain">
                        <Setter Property="BackgroundColor" Value="#FFA000" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding Egoera}" Value="Onartua">
                        <Setter Property="BackgroundColor" Value="#388E3C" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding Egoera}" Value="Ukatua">
                        <Setter Property="BackgroundColor" Value="#C62828" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding Egoera}" Value="Ezeztatua">
                        <Setter Property="BackgroundColor" Value="#757575" />
                    </DataTrigger>
                </Border.Triggers>
                <Label Text="{Binding Egoera}" TextColor="White" FontAttributes="Bold" FontSize="14" />
            </Border>

            <!-- Main info -->
            <Border Padding="14" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="10">

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Kategoria" FontSize="12"
                               TextColor="{AppThemeBinding Light=#777, Dark=#AAA}" />
                        <Label Text="{Binding Helmuga}" FontAttributes="Bold" FontSize="16" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light=#E0E0E0, Dark=#444}" />

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Zenbatekoa" FontSize="12"
                               TextColor="{AppThemeBinding Light=#777, Dark=#AAA}" />
                        <Label Text="{Binding GastuenGuztira, StringFormat='{0:N2} €'}"
                               FontAttributes="Bold" FontSize="20"
                               TextColor="{AppThemeBinding Light=#1565C0, Dark=#90CAF9}" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light=#E0E0E0, Dark=#444}" />

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Data" FontSize="12"
                               TextColor="{AppThemeBinding Light=#777, Dark=#AAA}" />
                        <Label Text="{Binding DataTestua}" FontSize="15" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light=#E0E0E0, Dark=#444}" />

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Deskribapena" FontSize="12"
                               TextColor="{AppThemeBinding Light=#777, Dark=#AAA}" />
                        <Label Text="{Binding Deskribapena}" FontSize="14" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- Admin comment (only when audited) -->
            <Border Padding="14" StrokeShape="RoundRectangle 10"
                    BackgroundColor="{AppThemeBinding Light=#FFF8E1, Dark=#3E3000}"
                    IsVisible="{Binding AdminOharraIkagarri}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Administratzailearen oharra" FontSize="12" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#F57F17, Dark=#FFD54F}" />
                    <Label Text="{Binding AdminOharra}" FontSize="14" />
                </VerticalStackLayout>
            </Border>

            <!-- Ticket photo -->
            <Border Padding="8" StrokeShape="RoundRectangle 10"
                    IsVisible="{Binding ArgazkiDago}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Ticket argazkia" FontSize="12" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#777, Dark=#AAA}" />
                    <Image Source="{Binding ArgazkiUrl}"
                           HeightRequest="220"
                           Aspect="AspectFit" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Itzuli"
                    Command="{Binding ItzeliCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light=#1565C0, Dark=#90CAF9}"
                    Margin="0,8,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
