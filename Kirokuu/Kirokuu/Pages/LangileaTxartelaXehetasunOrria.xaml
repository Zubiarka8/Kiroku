<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kirokuu.ViewModels"
             xmlns:kiro="clr-namespace:Kirokuu"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:kontrolak="clr-namespace:Kirokuu.Controls"
             x:Class="Kirokuu.Pages.LangileaTxartelaXehetasunOrria"
             x:DataType="vm:LangileaTxartelaXehetasunViewModel"
             Title="Txartel xehetasunak">

    <kontrolak:OrriKargatzeEskema IsKargatzean="{Binding IsKargatzean}"
                                  ErroreMezua="{Binding ErroreMezua}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="14">

                <kontrolak:TxartelXehetasunHeroaView Egoera="{Binding Egoera}"
                                                     Helmuga="{Binding Helmuga}"
                                                     Zenbatekoa="{Binding GastuenGuztira}"
                                                     DataTestua="{Binding DataTestua}" />

                <Border Style="{StaticResource TxartelTxartelaEstiloa}" Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Xehetasunak"
                               Style="{StaticResource TituluAtalaEstiloa}" />
                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource MugaArinaArgia}, Dark={StaticResource MugaArinaIluna}}" />
                        <VerticalStackLayout Spacing="3"
                                             IsVisible="{Binding SailarenEtiketa, Converter={StaticResource TestuaDagoConverter}}">
                            <Label Text="Saila"
                                   Style="{StaticResource EremuEtiketaEstiloa}" />
                            <Label Text="{Binding SailarenEtiketa}"
                                   FontSize="14"
                                   FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="3" IsVisible="{Binding IbilgailuaXehetasunakIkagarri}">
                            <Label Text="Ibilgailua"
                                   Style="{StaticResource EremuEtiketaEstiloa}" />
                            <Label Text="{Binding IbilgailuaMotaTestua}"
                                   FontSize="14"
                                   FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="3" IsVisible="{Binding KilometroakBistaratzeaIkagarri}">
                            <Label Text="Kilometroak"
                                   Style="{StaticResource EremuEtiketaEstiloa}" />
                            <Label Text="{Binding KilometroakBistaratzea, StringFormat='{0} km'}"
                                   FontSize="14"
                                   FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="3"
                                             IsVisible="{Binding GarraioBideaIkagarri}">
                            <Label Text="Garraioa"
                                   Style="{StaticResource EremuEtiketaEstiloa}" />
                            <Label Text="{Binding GarraioBideaTestua}"
                                   FontSize="14"
                                   FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource MugaArinaArgia}, Dark={StaticResource MugaArinaIluna}}"
                                 IsVisible="{Binding IbilgailuaXehetasunakIkagarri}" />
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Deskribapena"
                                   Style="{StaticResource EremuEtiketaEstiloa}" />
                            <Label Text="{Binding Deskribapena}"
                                   FontSize="14" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <kontrolak:TxartelXehetasunGastuZerrendaView GastuLerroak="{Binding GastuLerroak}" />

                <Border Style="{StaticResource OharraKutxaEstiloa}"
                        IsVisible="{Binding AdminOharraIkagarri}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Administratzailearen oharra"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource OharraTestuArgia}, Dark={StaticResource OharraTestuIluna}}" />
                        <Label Text="{Binding AdminOharra}"
                               FontSize="14" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource TxartelTxartelaEstiloa}"
                        Padding="16"
                        IsVisible="{Binding ArgazkiDago}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding IrekiArgazkiaHandianCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="Ticket argazkia"
                                   Style="{StaticResource EremuEtiketaEstiloa}"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="Handitu"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource EstekaNagusiaArgia}, Dark={StaticResource EstekaNagusiaIluna}}"
                                   VerticalOptions="Center" />
                        </Grid>
                        <Border StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray950}}"
                                Padding="8">
                            <Image Source="{Binding ArgazkiUrl}"
                                   HeightRequest="240"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Center" />
                        </Border>
                        <Label Text="Sakatu argazkia handitzeko"
                               FontSize="12"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource TestuBigarrenMailaArgia}, Dark={StaticResource TestuBigarrenMailaIluna}}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource TxartelTxartelaEstiloa}"
                        Padding="16"
                        IsVisible="{Binding ArgazkiDago, Converter={toolkit:InvertedBoolConverter}}">
                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                        <Label Style="{StaticResource IkonoHandiaEstiloa}"
                               Text="{x:Static kiro:IkonoFontIturria.ArgazkiaIkonoGlifoa}"
                               Opacity="0.5"
                               SemanticProperties.Description="Ez dago argazkirik" />
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="Ez da ticket argazkirik erantsi"
                                   FontAttributes="Bold"
                                   FontSize="14" />
                            <Label Text="Txartel honek ez du eranskin argazkirik."
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource TestuBigarrenMailaArgia}, Dark={StaticResource TestuBigarrenMailaIluna}}" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>

                <Button Text="Itzuli"
                        Command="{Binding ItzeliCommand}"
                        Style="{StaticResource EstekaBotoiEstiloa}"
                        Margin="0,4,0,4" />

            </VerticalStackLayout>
        </ScrollView>
    </kontrolak:OrriKargatzeEskema>
</ContentPage>
