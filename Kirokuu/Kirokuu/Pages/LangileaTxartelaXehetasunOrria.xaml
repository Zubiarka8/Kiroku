<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kirokuu.ViewModels"
             xmlns:datu="clr-namespace:Kirokuu.DatuBasea.Ereduak"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Kirokuu.Pages.LangileaTxartelaXehetasunOrria"
             x:DataType="vm:LangileaTxartelaXehetasunViewModel"
             Title="Txartel xehetasunak">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <ActivityIndicator IsRunning="{Binding IsKargatzean}"
                               IsVisible="{Binding IsKargatzean}"
                               HorizontalOptions="Center" />

            <Label Text="{Binding ErroreMezua}"
                   Style="{StaticResource ErroreEtiketaEstiloa}"
                   IsVisible="{Binding ErroreMezua, Converter={toolkit:IsStringNotNullOrEmptyConverter}}" />

            <Border Padding="10,6" StrokeShape="RoundRectangle 8" HorizontalOptions="Start">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding Egoera}" Value="Zain">
                        <Setter Property="BackgroundColor" Value="{StaticResource EgoeraZainAtzekoa}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding Egoera}" Value="Onartua">
                        <Setter Property="BackgroundColor" Value="{StaticResource EgoeraOnartuaAtzekoa}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding Egoera}" Value="Ukatua">
                        <Setter Property="BackgroundColor" Value="{StaticResource EgoeraUkatuaAtzekoa}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding Egoera}" Value="Ezeztatua">
                        <Setter Property="BackgroundColor" Value="{StaticResource EgoeraEzeztatuaAtzekoa}" />
                    </DataTrigger>
                </Border.Triggers>
                <Label Text="{Binding Egoera}"
                       Style="{StaticResource EgoeraEtiketaTestuaEstiloa}"
                       FontSize="14" />
            </Border>

            <Border Style="{StaticResource TxartelTxartelaEstiloa}" Padding="14">
                <VerticalStackLayout Spacing="10">

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Kategoria"
                               Style="{StaticResource EremuEtiketaEstiloa}" />
                        <Label Text="{Binding Helmuga}" FontAttributes="Bold" FontSize="16" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light={StaticResource MugaArinaArgia}, Dark={StaticResource MugaArinaIluna}}" />

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Zenbatekoa"
                               Style="{StaticResource EremuEtiketaEstiloa}" />
                        <Label Text="{Binding GastuenGuztira, StringFormat='{0:N2} €'}"
                               FontAttributes="Bold" FontSize="20"
                               TextColor="{AppThemeBinding Light={StaticResource EstekaNagusiaArgia}, Dark={StaticResource EstekaNagusiaIluna}}" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light={StaticResource MugaArinaArgia}, Dark={StaticResource MugaArinaIluna}}" />

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Data"
                               Style="{StaticResource EremuEtiketaEstiloa}" />
                        <Label Text="{Binding DataTestua}" FontSize="15" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light={StaticResource MugaArinaArgia}, Dark={StaticResource MugaArinaIluna}}" />

                    <VerticalStackLayout Spacing="2"
                                         IsVisible="{Binding GarraioBideaIkagarri}">
                        <Label Text="Garraioa"
                               Style="{StaticResource EremuEtiketaEstiloa}" />
                        <Label Text="{Binding GarraioBideaTestua}" FontSize="14" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light={StaticResource MugaArinaArgia}, Dark={StaticResource MugaArinaIluna}}"
                             IsVisible="{Binding GarraioBideaIkagarri}" />

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Deskribapena"
                               Style="{StaticResource EremuEtiketaEstiloa}" />
                        <Label Text="{Binding Deskribapena}" FontSize="14" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource OharraKutxaEstiloa}"
                    IsVisible="{Binding AdminOharraIkagarri}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Administratzailearen oharra"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource OharraTestuArgia}, Dark={StaticResource OharraTestuIluna}}" />
                    <Label Text="{Binding AdminOharra}" FontSize="14" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource TxartelTxartelaEstiloa}"
                    Padding="8"
                    IsVisible="{Binding ArgazkiDago}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Ticket argazkia"
                           FontSize="12"
                           FontAttributes="Bold"
                           Style="{StaticResource EremuEtiketaEstiloa}" />
                    <Image Source="{Binding ArgazkiUrl}"
                           HeightRequest="220"
                           Aspect="AspectFit" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Itzuli"
                    Command="{Binding ItzeliCommand}"
                    Style="{StaticResource EstekaBotoiEstiloa}"
                    Margin="0,8,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
