<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kirokuu.ViewModels"
             xmlns:datu="clr-namespace:Kirokuu.DatuEreduak"
             xmlns:kiro="clr-namespace:Kirokuu"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:pages="clr-namespace:Kirokuu.Pages"
             xmlns:kontrolak="clr-namespace:Kirokuu.Controls"
             x:Class="Kirokuu.Pages.NireTxartelakOrria"
             x:Name="NireTxartelakOrriaErreferentzia"
             x:DataType="vm:NireTxartelakViewModel"
             Title="Nire txartelak">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing"
                                        Command="{Binding AgertzenDeneanCommand}" />
    </ContentPage.Behaviors>

    <kontrolak:OrriKargatzeEskema IsKargatzean="{Binding IsKargatzean}"
                                  ErroreMezua="{Binding ErroreMezua}">
    <Grid RowDefinitions="*,Auto" Padding="20,12,20,0">

        <RefreshView Grid.Row="0"
                     Command="{Binding AgertzenDeneanCommand}"
                     IsRefreshing="{Binding IsKargatzean}">
            <CollectionView ItemsSource="{Binding Txartelak}"
                            SelectionMode="None"
                            Margin="0,4,0,88">
                <CollectionView.Header>
                    <VerticalStackLayout Spacing="14" Padding="0,4,0,8">

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Zure gastu-txartelak"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   SemanticProperties.HeadingLevel="Level1" />
                            <Label Text="Jarraitu zure bidalketen egoera eta kudeatu zain daudenak."
                                   FontSize="13"
                                   LineBreakMode="WordWrap"
                                   TextColor="{AppThemeBinding Light={StaticResource TestuBigarrenMailaArgia}, Dark={StaticResource TestuBigarrenMailaIluna}}" />
                        </VerticalStackLayout>

                        <Border StrokeThickness="0"
                                StrokeShape="RoundRectangle 16"
                                Padding="16,14"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray900}}">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="{Binding LaburpenGoiburua}"
                                       FontAttributes="Bold"
                                       FontSize="15"
                                       VerticalOptions="Center" />
                                <Label Grid.Row="1" Grid.Column="0"
                                       Text="Iragazkian agertzen direnak"
                                       FontSize="12"
                                       Margin="0,4,0,0"
                                       TextColor="{AppThemeBinding Light={StaticResource TestuBigarrenMailaArgia}, Dark={StaticResource TestuBigarrenMailaIluna}}" />
                                <VerticalStackLayout Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                                     VerticalOptions="Center"
                                                     HorizontalOptions="End"
                                                     Spacing="0">
                                    <Label Text="{Binding ZenbatekoGuztiraErakusten, StringFormat='{0:N2} €'}"
                                           FontSize="26"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="End"
                                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <Label Text="Laburpena"
                               Style="{StaticResource TituluAtalaEstiloa}"
                               FontSize="14"
                               Margin="0,0,0,-6" />

                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">

                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource EgoeraLaburpenTxartelaEstiloa}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding AldatuIragazkiaCommand}" CommandParameter="Zain" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding KopuruaZain}" Style="{StaticResource EgoeraLaburpenKopuruaEstiloa}"
                                           TextColor="{StaticResource EgoeraZainAtzekoa}" />
                                    <Label Text="Zain" Style="{StaticResource EgoeraLaburpenEtiketaEstiloa}" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource EgoeraLaburpenTxartelaEstiloa}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding AldatuIragazkiaCommand}" CommandParameter="Onartua" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding KopuruaOnartua}" Style="{StaticResource EgoeraLaburpenKopuruaEstiloa}"
                                           TextColor="{StaticResource EgoeraOnartuaAtzekoa}" />
                                    <Label Text="Onartua" Style="{StaticResource EgoeraLaburpenEtiketaEstiloa}" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource EgoeraLaburpenTxartelaEstiloa}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding AldatuIragazkiaCommand}" CommandParameter="Ukatua" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding KopuruaUkatua}" Style="{StaticResource EgoeraLaburpenKopuruaEstiloa}"
                                           TextColor="{StaticResource EgoeraUkatuaAtzekoa}" />
                                    <Label Text="Ukatua" Style="{StaticResource EgoeraLaburpenEtiketaEstiloa}" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource EgoeraLaburpenTxartelaEstiloa}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding AldatuIragazkiaCommand}" CommandParameter="Ezeztatua" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding KopuruaEzeztatua}" Style="{StaticResource EgoeraLaburpenKopuruaEstiloa}"
                                           TextColor="{StaticResource EgoeraEzeztatuaAtzekoa}" />
                                    <Label Text="Ezeztatua" Style="{StaticResource EgoeraLaburpenEtiketaEstiloa}" />
                                </VerticalStackLayout>
                            </Border>

                        </Grid>

                        <Label Text="Iragazi egoeraren arabera"
                               Style="{StaticResource TituluAtalaEstiloa}"
                               FontSize="14"
                               Margin="0,0,0,-6" />

                        <ScrollView Orientation="Horizontal"
                                    HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Spacing="8">

                                <Border Style="{StaticResource IragazkiTxipEstiloa}"
                                        Stroke="{StaticResource EstekaNagusiaArgia}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IragazkiaGuztiakHautatua}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource EstekaNagusiaArgia}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding IragazkiaGuztiakHautatua}" Value="False">
                                            <Setter Property="BackgroundColor" Value="Transparent" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding AldatuIragazkiaCommand}" CommandParameter="Guztiak" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="Guztiak" Style="{StaticResource IragazkiTxipTestuEstiloa}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IragazkiaGuztiakHautatua}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource White}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IragazkiaGuztiakHautatua}" Value="False">
                                                    <Setter Property="TextColor" Value="{StaticResource EstekaNagusiaArgia}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label Text="{Binding KopuruaGuztiak, StringFormat='({0})'}" Style="{StaticResource IragazkiTxipKopuruEstiloa}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IragazkiaGuztiakHautatua}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource White}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IragazkiaGuztiakHautatua}" Value="False">
                                                    <Setter Property="TextColor" Value="{StaticResource EstekaNagusiaArgia}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </HorizontalStackLayout>
                                </Border>

                                <Border Style="{StaticResource IragazkiTxipEstiloa}" Stroke="{StaticResource EgoeraZainAtzekoa}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IragazkiaZainHautatua}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource EgoeraZainAtzekoa}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding IragazkiaZainHautatua}" Value="False">
                                            <Setter Property="BackgroundColor" Value="Transparent" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding AldatuIragazkiaCommand}" CommandParameter="Zain" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="Zain" Style="{StaticResource IragazkiTxipTestuEstiloa}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IragazkiaZainHautatua}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource White}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IragazkiaZainHautatua}" Value="False">
                                                    <Setter Property="TextColor" Value="{StaticResource EgoeraZainAtzekoa}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label Text="{Binding KopuruaZain, StringFormat='({0})'}" Style="{StaticResource IragazkiTxipKopuruEstiloa}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IragazkiaZainHautatua}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource White}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IragazkiaZainHautatua}" Value="False">
                                                    <Setter Property="TextColor" Value="{StaticResource EgoeraZainAtzekoa}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </HorizontalStackLayout>
                                </Border>

                                <Border Style="{StaticResource IragazkiTxipEstiloa}" Stroke="{StaticResource EgoeraOnartuaAtzekoa}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IragazkiaOnartuaHautatua}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource EgoeraOnartuaAtzekoa}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding IragazkiaOnartuaHautatua}" Value="False">
                                            <Setter Property="BackgroundColor" Value="Transparent" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding AldatuIragazkiaCommand}" CommandParameter="Onartua" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="Onartua" Style="{StaticResource IragazkiTxipTestuEstiloa}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IragazkiaOnartuaHautatua}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource White}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IragazkiaOnartuaHautatua}" Value="False">
                                                    <Setter Property="TextColor" Value="{StaticResource EgoeraOnartuaAtzekoa}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label Text="{Binding KopuruaOnartua, StringFormat='({0})'}" Style="{StaticResource IragazkiTxipKopuruEstiloa}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IragazkiaOnartuaHautatua}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource White}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IragazkiaOnartuaHautatua}" Value="False">
                                                    <Setter Property="TextColor" Value="{StaticResource EgoeraOnartuaAtzekoa}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </HorizontalStackLayout>
                                </Border>

                                <Border Style="{StaticResource IragazkiTxipEstiloa}" Stroke="{StaticResource EgoeraUkatuaAtzekoa}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IragazkiaUkatuaHautatua}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource EgoeraUkatuaAtzekoa}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding IragazkiaUkatuaHautatua}" Value="False">
                                            <Setter Property="BackgroundColor" Value="Transparent" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding AldatuIragazkiaCommand}" CommandParameter="Ukatua" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="Ukatua" Style="{StaticResource IragazkiTxipTestuEstiloa}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IragazkiaUkatuaHautatua}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource White}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IragazkiaUkatuaHautatua}" Value="False">
                                                    <Setter Property="TextColor" Value="{StaticResource EgoeraUkatuaAtzekoa}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label Text="{Binding KopuruaUkatua, StringFormat='({0})'}" Style="{StaticResource IragazkiTxipKopuruEstiloa}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IragazkiaUkatuaHautatua}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource White}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IragazkiaUkatuaHautatua}" Value="False">
                                                    <Setter Property="TextColor" Value="{StaticResource EgoeraUkatuaAtzekoa}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </HorizontalStackLayout>
                                </Border>

                                <Border Style="{StaticResource IragazkiTxipEstiloa}" Stroke="{StaticResource EgoeraEzeztatuaAtzekoa}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IragazkiaEzeztatuaHautatua}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource EgoeraEzeztatuaAtzekoa}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding IragazkiaEzeztatuaHautatua}" Value="False">
                                            <Setter Property="BackgroundColor" Value="Transparent" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding AldatuIragazkiaCommand}" CommandParameter="Ezeztatua" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="Ezeztatua" Style="{StaticResource IragazkiTxipTestuEstiloa}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IragazkiaEzeztatuaHautatua}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource White}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IragazkiaEzeztatuaHautatua}" Value="False">
                                                    <Setter Property="TextColor" Value="{StaticResource EgoeraEzeztatuaAtzekoa}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label Text="{Binding KopuruaEzeztatua, StringFormat='({0})'}" Style="{StaticResource IragazkiTxipKopuruEstiloa}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IragazkiaEzeztatuaHautatua}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource White}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IragazkiaEzeztatuaHautatua}" Value="False">
                                                    <Setter Property="TextColor" Value="{StaticResource EgoeraEzeztatuaAtzekoa}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </HorizontalStackLayout>
                                </Border>

                            </HorizontalStackLayout>
                        </ScrollView>

                        <Label Text="Zerrenda"
                               Style="{StaticResource TituluAtalaEstiloa}"
                               FontSize="14"
                               Margin="0,4,0,-4" />

                    </VerticalStackLayout>
                </CollectionView.Header>

                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center"
                                         Spacing="16" Padding="24,40">
                        <Border StrokeThickness="0"
                                StrokeShape="RoundRectangle 40"
                                WidthRequest="80"
                                HeightRequest="80"
                                HorizontalOptions="Center"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}">
                            <Label Style="{StaticResource IkonoHandiaEstiloa}"
                                   Text="{x:Static kiro:IkonoFontIturria.HutsikIkonoGlifoa}"
                                   FontSize="36"
                                   Margin="0"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   SemanticProperties.Description="Hutsik" />
                        </Border>
                        <Label Text="Ez dago txartelik iragazki honetan"
                               HorizontalTextAlignment="Center"
                               FontAttributes="Bold"
                               FontSize="17" />
                        <Label Text="Sortu gastu berri bat edo aldatu iragazkia goiko txipetan."
                               HorizontalTextAlignment="Center"
                               FontSize="13"
                               LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light={StaticResource TestuBigarrenMailaArgia}, Dark={StaticResource TestuBigarrenMailaIluna}}" />
                        <Button Text="Gastu berria gehitu"
                                Command="{Binding TxartelBerriaSortuCommand}"
                                HorizontalOptions="Center"
                                Padding="24,0"
                                MinimumWidthRequest="200">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="MaterialIcons"
                                                 Glyph="{x:Static kiro:IkonoFontIturria.GehituIkonoGlifoa}"
                                                 Size="20"
                                                 Color="{StaticResource White}" />
                            </Button.ImageSource>
                        </Button>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="datu:TxostenOnarpenLaburpena">
                        <SwipeView Margin="0,6">
                            <SwipeView.RightItems>
                                <SwipeItems Mode="Reveal">
                                    <SwipeItem Text="Ezeztatu"
                                               BackgroundColor="{StaticResource EgoeraUkatuaAtzekoa}"
                                               IsVisible="{Binding EzeztatuDaiteke}"
                                               Command="{Binding Path=BindingContext.EzeztatuTxartelaCommand, Source={x:Reference NireTxartelakOrriaErreferentzia}, x:DataType={x:Type pages:NireTxartelakOrria}}"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Border Style="{StaticResource TxartelTxartelaEstiloa}"
                                    Padding="0">
                                <Border.Shadow>
                                    <Shadow Brush="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Black}}"
                                            Offset="0,2"
                                            Radius="8"
                                            Opacity="0.25" />
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Path=BindingContext.IkusiXehetasunaCommand, Source={x:Reference NireTxartelakOrriaErreferentzia}, x:DataType={x:Type pages:NireTxartelakOrria}}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="5,*,Auto" ColumnSpacing="0">

                                    <BoxView Grid.Column="0" CornerRadius="12,0,0,12">
                                        <BoxView.Triggers>
                                            <DataTrigger TargetType="BoxView" Binding="{Binding Egoera}" Value="Zain">
                                                <Setter Property="Color" Value="{StaticResource EgoeraZainAtzekoa}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="BoxView" Binding="{Binding Egoera}" Value="Onartua">
                                                <Setter Property="Color" Value="{StaticResource EgoeraOnartuaAtzekoa}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="BoxView" Binding="{Binding Egoera}" Value="Ukatua">
                                                <Setter Property="Color" Value="{StaticResource EgoeraUkatuaAtzekoa}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="BoxView" Binding="{Binding Egoera}" Value="Ezeztatua">
                                                <Setter Property="Color" Value="{StaticResource EgoeraEzeztatuaAtzekoa}" />
                                            </DataTrigger>
                                        </BoxView.Triggers>
                                    </BoxView>

                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="6"
                                                         Padding="14,14,8,14">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Label Grid.Column="0"
                                                   Text="{Binding Helmuga}"
                                                   FontAttributes="Bold"
                                                   FontSize="16"
                                                   LineBreakMode="TailTruncation"
                                                   VerticalOptions="Center" />
                                            <Border Grid.Column="1"
                                                    Padding="10,5"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 12"
                                                    VerticalOptions="Center">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding Egoera}" Value="Zain">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource EgoeraZainAtzekoa}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border" Binding="{Binding Egoera}" Value="Onartua">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource EgoeraOnartuaAtzekoa}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border" Binding="{Binding Egoera}" Value="Ukatua">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource EgoeraUkatuaAtzekoa}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border" Binding="{Binding Egoera}" Value="Ezeztatua">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource EgoeraEzeztatuaAtzekoa}" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Label Text="{Binding Egoera}"
                                                       Style="{StaticResource EgoeraEtiketaTestuaEstiloa}"
                                                       FontSize="11" />
                                            </Border>
                                        </Grid>

                                        <HorizontalStackLayout Spacing="6"
                                                               IsVisible="{Binding DataFormateatua, Converter={StaticResource TestuaDagoConverter}}">
                                            <Label FontFamily="MaterialIcons"
                                                   Text="&#xe916;"
                                                   FontSize="14"
                                                   VerticalOptions="Center"
                                                   TextColor="{AppThemeBinding Light={StaticResource TestuBigarrenMailaArgia}, Dark={StaticResource TestuBigarrenMailaIluna}}" />
                                            <Label Text="{Binding DataFormateatua}"
                                                   FontSize="13"
                                                   VerticalOptions="Center"
                                                   TextColor="{AppThemeBinding Light={StaticResource TestuBigarrenMailaArgia}, Dark={StaticResource TestuBigarrenMailaIluna}}" />
                                        </HorizontalStackLayout>

                                        <HorizontalStackLayout Spacing="6">
                                            <Label FontFamily="MaterialIcons"
                                                   Text="{x:Static kiro:IkonoFontIturria.DiruaIkonoGlifoa}"
                                                   FontSize="16"
                                                   VerticalOptions="Center"
                                                   TextColor="{AppThemeBinding Light={StaticResource EstekaNagusiaArgia}, Dark={StaticResource EstekaNagusiaIluna}}" />
                                            <Label Text="{Binding GastuenBatuketakoZenbatekoa, StringFormat='{0:N2} €'}"
                                                   FontAttributes="Bold"
                                                   FontSize="20"
                                                   VerticalOptions="Center"
                                                   TextColor="{AppThemeBinding Light={StaticResource EstekaNagusiaArgia}, Dark={StaticResource EstekaNagusiaIluna}}" />
                                        </HorizontalStackLayout>

                                        <Label Text="Irristatu ezeztatzeko · sakatu xehetasunak"
                                               FontSize="11"
                                               Margin="0,2,0,0"
                                               IsVisible="{Binding EzeztatuDaiteke}"
                                               TextColor="{AppThemeBinding Light={StaticResource OharraTestuArgia}, Dark={StaticResource OharraTestuIluna}}" />
                                    </VerticalStackLayout>

                                    <Label Grid.Column="2"
                                           FontFamily="MaterialIcons"
                                           Text="{x:Static kiro:IkonoFontIturria.ChevronEskuinaIkonoGlifoa}"
                                           FontSize="22"
                                           VerticalOptions="Center"
                                           Margin="0,0,12,0"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />

                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Border Grid.Row="1"
                Margin="0,0,0,24"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 28"
                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                HorizontalOptions="Fill"
                VerticalOptions="End">
            <Border.Shadow>
                <Shadow Brush="{StaticResource Primary}"
                        Offset="0,4"
                        Radius="12"
                        Opacity="0.35" />
            </Border.Shadow>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding TxartelBerriaSortuCommand}" />
            </Border.GestureRecognizers>
            <Grid ColumnDefinitions="Auto,*" Padding="18,14" ColumnSpacing="12">
                <Label FontFamily="MaterialIcons"
