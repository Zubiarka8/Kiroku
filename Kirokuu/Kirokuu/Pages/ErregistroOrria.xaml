<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kirokuu.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Kirokuu.Pages.ErregistroOrria"
             x:DataType="vm:ErregistroViewModel"
             Title="Kontua sortu">

    <ContentPage.Resources>
        <toolkit:IsStringNotNullOrEmptyConverter x:Key="TestuaDagoConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <ActivityIndicator IsRunning="{Binding IsKargatzean}"
                               IsVisible="{Binding IsKargatzean}"
                               HorizontalOptions="Center" />

            <Label Text="Erabiltzaile berria"
                   Style="{StaticResource Headline}"
                   HorizontalOptions="Center" />

            <Label Text="Langile kontua sortuko da."
                   Style="{StaticResource SubHeadline}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

            <Entry x:Name="IzenaSarrera"
                   Text="{Binding Izena}"
                   Placeholder="Izena"
                   SemanticProperties.Hint="Izena" />

            <Entry x:Name="AbizenaSarrera"
                   Text="{Binding Abizena}"
                   Placeholder="Abizena"
                   SemanticProperties.Hint="Abizena" />

            <Entry x:Name="Abizena2Sarrera"
                   Text="{Binding Abizena2}"
                   Placeholder="Bigarren abizena"
                   SemanticProperties.Hint="Bigarren abizena" />

            <Entry x:Name="DniSarrera"
                   Text="{Binding Dni}"
                   Placeholder="DNI / NAN"
                   SemanticProperties.Hint="DNI edo NAN" />

            <Label Text="Sektorea" FontAttributes="Bold" />
            <Picker x:Name="SektoreaErregistroHautapena"
                    ItemsSource="{Binding SektoreenAukerak}"
                    ItemDisplayBinding="{Binding Etiketa}"
                    SelectedItem="{Binding HautatutakoSektorea}"
                    Title="Aukeratu sektorea" />

            <Label Text="Kargoa" FontAttributes="Bold" />
            <Picker x:Name="KargoaErregistroHautapena"
                    ItemsSource="{Binding KargoenAukerak}"
                    ItemDisplayBinding="{Binding Etiketa}"
                    SelectedItem="{Binding HautatutakoKargoa}"
                    Title="Aukeratu kargoa" />

            <Entry x:Name="PostaErregistroSarrera"
                   Text="{Binding Posta}"
                   Placeholder="Posta"
                   Keyboard="Email"
                   SemanticProperties.Hint="Posta elektronikoa" />

            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="4"
                  VerticalOptions="Center">
                <Entry x:Name="PasahitzaErregistroSarrera"
                       Grid.Column="0"
                       Text="{Binding Pasahitza}"
                       Placeholder="Pasahitza (min. 8)"
                       IsPassword="{Binding PasahitzaMaskaratuta}"
                       SemanticProperties.Hint="Pasahitza" />
                <ImageButton x:Name="PasahitzaErregistroBegiTekla"
                             Grid.Column="1"
                             Source="{Binding PasahitzaBegiarenIrudiarenIzena}"
                             Command="{Binding AlderantzikatuPasahitzaMaskaCommand}"
                             BackgroundColor="Transparent"
                             BorderWidth="0"
                             Padding="8"
                             WidthRequest="44"
                             HeightRequest="44"
                             VerticalOptions="Center"
                             Aspect="AspectFit"
                             SemanticProperties.Description="{Binding PasahitzaBegiarenDeskribapena}" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="4"
                  VerticalOptions="Center">
                <Entry x:Name="PasahitzaBerretsiSarrera"
                       Grid.Column="0"
                       Text="{Binding PasahitzaBerretsi}"
                       Placeholder="Pasahitza berretsi"
                       IsPassword="{Binding PasahitzaBerretsiMaskaratuta}"
                       SemanticProperties.Hint="Pasahitza berretsi" />
                <ImageButton x:Name="PasahitzaBerretsiBegiTekla"
                             Grid.Column="1"
                             Source="{Binding PasahitzaBerretsiBegiarenIrudiarenIzena}"
                             Command="{Binding AlderantzikatuPasahitzaBerretsiMaskaCommand}"
                             BackgroundColor="Transparent"
                             BorderWidth="0"
                             Padding="8"
                             WidthRequest="44"
                             HeightRequest="44"
                             VerticalOptions="Center"
                             Aspect="AspectFit"
                             SemanticProperties.Description="{Binding PasahitzaBerretsiBegiarenDeskribapena}" />
            </Grid>

            <Label Text="{Binding ErroreMezua}"
                   Style="{StaticResource ErroreEtiketaEstiloa}"
                   LineBreakMode="WordWrap"
                   MaximumWidthRequest="520" />

            <Label Text="{Binding ErroreXehetasuna}"
                   Style="{StaticResource ErroreEtiketaEstiloa}"
                   LineBreakMode="WordWrap"
                   MaximumWidthRequest="520"
                   FontSize="13"
                   IsVisible="{Binding ErroreXehetasuna, Converter={StaticResource TestuaDagoConverter}}" />

            <Button x:Name="ErregistratuTekla"
                    Text="Erregistratu"
                    Command="{Binding ErregistratuCommand}" />

            <Button x:Name="ItzuliTekla"
                    Text="Itzuli"
                    Command="{Binding ItzuliCommand}"
                    Style="{StaticResource BotoiBigarrenMailakoaEstiloa}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
