<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kirokuu.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Kirokuu.Pages.AplikazioIrekitzeOrria"
             x:DataType="vm:AplikazioIrekitzeViewModel"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing"
                                        Command="{Binding AgertzenDeneanCommand}" />
    </ContentPage.Behaviors>

    <Grid BackgroundColor="Black"
          IgnoreSafeArea="True">

        <Image x:Name="HasieraLogoa"
               Source="kiroku_logo.webp"
               Opacity="{Binding LogoaIkusgarritasuna}"
               Scale="{Binding LogoaEskalaketa}"
               Aspect="AspectFit"
               WidthRequest="240"
               HeightRequest="240"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               SemanticProperties.Description="Kirokuu aplikazioaren logoa" />
    </Grid>
</ContentPage>
