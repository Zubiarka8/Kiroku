<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:kiro="clr-namespace:Kirokuu"
             x:Class="Kirokuu.Pages.LasterEdukiaOrria"
             Title="Laster">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">
            <Label Style="{StaticResource IkonoHandiaEstiloa}"
                   Text="{x:Static kiro:IkonoFontIturria.LasterEdukiaIkonoGlifoa}"
                   SemanticProperties.Description="Laster" />
            <Label Text="Atal hau laster egongo da eskuragarri."
                   Style="{StaticResource Headline}"
                   HorizontalTextAlignment="Center" />
            <Label Text="Txartelak eta gastuak hemen kudeatuko dituzu."
                   HorizontalTextAlignment="Center"
                   Style="{StaticResource TestuBigarrenMailaEstiloa}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
