<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kirokuu.ViewModels"
             xmlns:datu="clr-namespace:Kirokuu.DatuEreduak"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Kirokuu.Pages.TxartelKanbanOrria"
             x:DataType="vm:TxartelKanbanViewModel"
             x:Name="TxartelKanbanOrriaErreferentzia"
             Title="Txartelak">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing"
                                        Command="{Binding AgertzenDeneanCommand}" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,Auto,*" Padding="12,8" RowSpacing="10">

        <ActivityIndicator Grid.Row="0"
                           IsRunning="{Binding IsKargatzean}"
                           IsVisible="{Binding IsKargatzean}"
                           HorizontalOptions="Center" />

        <Label Grid.Row="1"
               Text="{Binding ErroreMezua}"
               Style="{StaticResource ErroreEtiketaEstiloa}"
               IsVisible="{Binding ErroreMezua, Converter={toolkit:IsStringNotNullOrEmptyConverter}}" />

        <ScrollView Grid.Row="2"
                    Orientation="{OnIdiom Phone=Horizontal, Default=Vertical}">
            <Grid MinimumWidthRequest="{OnIdiom Phone=640, Default=0}"
                  ColumnDefinitions="*,*,*,*"
                  ColumnSpacing="8"
                  Padding="{OnIdiom Phone='0,0,16,0', Default='0'}">

                <VerticalStackLayout Grid.Column="0" Spacing="8">
                    <Border Style="{StaticResource KanpainGoiburuaEstiloa}"
                            BackgroundColor="{StaticResource EgoeraZainAtzekoa}">
                        <Label Text="Zain"
                               Style="{StaticResource EgoeraEtiketaTestuaEstiloa}"
                               FontSize="13"
                               HorizontalTextAlignment="Center" />
                    </Border>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding ZainZerrenda}" Spacing="8">
                        <BindableLayout.EmptyView>
                            <Label Text="—"
                                   Style="{StaticResource TestuHutsikEstiloa}"
                                   HorizontalTextAlignment="Center" />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="datu:TxostenOnarpenLaburpena">
                                <Border Style="{StaticResource TxartelTxartelaEstiloa}" Padding="10">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference TxartelKanbanOrriaErreferentzia}, Path=BindingContext.IkusiXehetasunaCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding Helmuga}" FontAttributes="Bold" FontSize="13" />
                                        <Label Text="{Binding GastuenBatuketakoZenbatekoa, StringFormat='{0:N2} €'}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource TestuBigarrenMailaArgia}, Dark={StaticResource TestuBigarrenMailaIluna}}" />
                                        <Button Text="Ezeztatu"
                                                Command="{Binding Source={x:Reference TxartelKanbanOrriaErreferentzia}, Path=BindingContext.EzeztatuTxartelaCommand}"
                                                CommandParameter="{Binding .}"
                                                Style="{StaticResource BotoiArriskuEstiloa}"
                                                FontSize="11"
                                                HeightRequest="34"
                                                Padding="8,0"
                                                Margin="0,4,0,0" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="8">
                    <Border Style="{StaticResource KanpainGoiburuaEstiloa}"
                            BackgroundColor="{StaticResource EgoeraOnartuaAtzekoa}">
                        <Label Text="Onartua"
                               Style="{StaticResource EgoeraEtiketaTestuaEstiloa}"
                               FontSize="13"
                               HorizontalTextAlignment="Center" />
                    </Border>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding OnartuaZerrenda}" Spacing="8">
                        <BindableLayout.EmptyView>
                            <Label Text="—"
                                   Style="{StaticResource TestuHutsikEstiloa}"
                                   HorizontalTextAlignment="Center" />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="datu:TxostenOnarpenLaburpena">
                                <Border Style="{StaticResource TxartelTxartelaEstiloa}" Padding="10">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference TxartelKanbanOrriaErreferentzia}, Path=BindingContext.IkusiXehetasunaCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding Helmuga}" FontAttributes="Bold" FontSize="13" />
                                        <Label Text="{Binding GastuenBatuketakoZenbatekoa, StringFormat='{0:N2} €'}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource TestuBigarrenMailaArgia}, Dark={StaticResource TestuBigarrenMailaIluna}}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2" Spacing="8">
                    <Border Style="{StaticResource KanpainGoiburuaEstiloa}"
                            BackgroundColor="{StaticResource EgoeraUkatuaAtzekoa}">
                        <Label Text="Ukatua"
                               Style="{StaticResource EgoeraEtiketaTestuaEstiloa}"
                               FontSize="13"
                               HorizontalTextAlignment="Center" />
                    </Border>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding UkatuaZerrenda}" Spacing="8">
                        <BindableLayout.EmptyView>
                            <Label Text="—"
                                   Style="{StaticResource TestuHutsikEstiloa}"
                                   HorizontalTextAlignment="Center" />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="datu:TxostenOnarpenLaburpena">
                                <Border Style="{StaticResource TxartelTxartelaEstiloa}" Padding="10">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference TxartelKanbanOrriaErreferentzia}, Path=BindingContext.IkusiXehetasunaCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding Helmuga}" FontAttributes="Bold" FontSize="13" />
                                        <Label Text="{Binding GastuenBatuketakoZenbatekoa, StringFormat='{0:N2} €'}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource TestuBigarrenMailaArgia}, Dark={StaticResource TestuBigarrenMailaIluna}}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="3" Spacing="8">
                    <Border Style="{StaticResource KanpainGoiburuaEstiloa}"
                            BackgroundColor="{StaticResource EgoeraEzeztatuaAtzekoa}">
                        <Label Text="Ezeztatua"
                               Style="{StaticResource EgoeraEtiketaTestuaEstiloa}"
                               FontSize="13"
                               HorizontalTextAlignment="Center" />
                    </Border>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding EzeztatuaZerrenda}" Spacing="8">
                        <BindableLayout.EmptyView>
                            <Label Text="—"
                                   Style="{StaticResource TestuHutsikEstiloa}"
                                   HorizontalTextAlignment="Center" />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="datu:TxostenOnarpenLaburpena">
                                <Border Style="{StaticResource TxartelTxartelaEstiloa}" Padding="10">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference TxartelKanbanOrriaErreferentzia}, Path=BindingContext.IkusiXehetasunaCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding Helmuga}" FontAttributes="Bold" FontSize="13" />
                                        <Label Text="{Binding GastuenBatuketakoZenbatekoa, StringFormat='{0:N2} €'}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource TestuBigarrenMailaArgia}, Dark={StaticResource TestuBigarrenMailaIluna}}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>
