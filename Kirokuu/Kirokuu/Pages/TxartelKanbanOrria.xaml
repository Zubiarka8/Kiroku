<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kirokuu.ViewModels"
             xmlns:datu="clr-namespace:Kirokuu.DatuEreduak"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Kirokuu.Pages.TxartelKanbanOrria"
             x:DataType="vm:TxartelKanbanViewModel"
             x:Name="TxartelKanbanOrriaErreferentzia"
             Title="Txartelak">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing"
                                        Command="{Binding AgertzenDeneanCommand}" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,Auto,*" Padding="8" RowSpacing="8">

        <ActivityIndicator Grid.Row="0"
                           IsRunning="{Binding IsKargatzean}"
                           IsVisible="{Binding IsKargatzean}"
                           HorizontalOptions="Center" />

        <Label Grid.Row="1"
               Text="{Binding ErroreMezua}"
               TextColor="{AppThemeBinding Light=#B00020, Dark=#FF8A80}"
               HorizontalTextAlignment="Center"
               IsVisible="{Binding ErroreMezua, Converter={toolkit:IsStringNotNullOrEmptyConverter}}" />

        <ScrollView Grid.Row="2">
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">

                <!-- Zain -->
                <VerticalStackLayout Grid.Column="0" Spacing="6">
                    <Border BackgroundColor="#FFA000" Padding="6,4" StrokeShape="RoundRectangle 6">
                        <Label Text="Zain" TextColor="White" FontAttributes="Bold"
                               HorizontalTextAlignment="Center" FontSize="13" />
                    </Border>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding ZainZerrenda}" Spacing="6">
                        <BindableLayout.EmptyView>
                            <Label Text="—" HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light=#999, Dark=#666}" />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="datu:TxostenOnarpenLaburpena">
                                <Border Padding="8" StrokeShape="RoundRectangle 8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Helmuga}" FontAttributes="Bold" FontSize="13" />
                                        <Label Text="{Binding GastuenBatuketakoZenbatekoa, StringFormat='{0:N2} €'}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light=#555, Dark=#AAA}" />
                                        <Button Text="Ezeztatu"
                                                Command="{Binding Source={x:Reference TxartelKanbanOrriaErreferentzia}, Path=BindingContext.EzeztatuTxartelaCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#757575"
                                                TextColor="White"
                                                FontSize="11"
                                                HeightRequest="32"
                                                Padding="8,0"
                                                Margin="0,4,0,0" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Onartua -->
                <VerticalStackLayout Grid.Column="1" Spacing="6">
                    <Border BackgroundColor="#388E3C" Padding="6,4" StrokeShape="RoundRectangle 6">
                        <Label Text="Onartua" TextColor="White" FontAttributes="Bold"
                               HorizontalTextAlignment="Center" FontSize="13" />
                    </Border>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding OnartuaZerrenda}" Spacing="6">
                        <BindableLayout.EmptyView>
                            <Label Text="—" HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light=#999, Dark=#666}" />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="datu:TxostenOnarpenLaburpena">
                                <Border Padding="8" StrokeShape="RoundRectangle 8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Helmuga}" FontAttributes="Bold" FontSize="13" />
                                        <Label Text="{Binding GastuenBatuketakoZenbatekoa, StringFormat='{0:N2} €'}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light=#555, Dark=#AAA}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Ukatua -->
                <VerticalStackLayout Grid.Column="2" Spacing="6">
                    <Border BackgroundColor="#C62828" Padding="6,4" StrokeShape="RoundRectangle 6">
                        <Label Text="Ukatua" TextColor="White" FontAttributes="Bold"
                               HorizontalTextAlignment="Center" FontSize="13" />
                    </Border>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding UkatuaZerrenda}" Spacing="6">
                        <BindableLayout.EmptyView>
                            <Label Text="—" HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light=#999, Dark=#666}" />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="datu:TxostenOnarpenLaburpena">
                                <Border Padding="8" StrokeShape="RoundRectangle 8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Helmuga}" FontAttributes="Bold" FontSize="13" />
                                        <Label Text="{Binding GastuenBatuketakoZenbatekoa, StringFormat='{0:N2} €'}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light=#555, Dark=#AAA}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Ezeztatua -->
                <VerticalStackLayout Grid.Column="3" Spacing="6">
                    <Border BackgroundColor="#757575" Padding="6,4" StrokeShape="RoundRectangle 6">
                        <Label Text="Ezeztatua" TextColor="White" FontAttributes="Bold"
                               HorizontalTextAlignment="Center" FontSize="13" />
                    </Border>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding EzeztatuaZerrenda}" Spacing="6">
                        <BindableLayout.EmptyView>
                            <Label Text="—" HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light=#999, Dark=#666}" />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="datu:TxostenOnarpenLaburpena">
                                <Border Padding="8" StrokeShape="RoundRectangle 8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Helmuga}" FontAttributes="Bold" FontSize="13" />
                                        <Label Text="{Binding GastuenBatuketakoZenbatekoa, StringFormat='{0:N2} €'}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light=#555, Dark=#AAA}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>
