<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kirokuu.ViewModels"
             xmlns:datu="clr-namespace:Kirokuu.DatuEreduak"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:kiro="clr-namespace:Kirokuu"
             x:Class="Kirokuu.Pages.MugimenduakOrria"
             x:Name="MugimenduakOrriaErreferentzia"
             x:DataType="vm:MugimenduakViewModel"
             Title="Mugimenduak">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing"
                                        Command="{Binding AgertzenDeneanCommand}" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,Auto,*" Padding="10" RowSpacing="10">
        <ActivityIndicator Grid.Row="0"
                           IsRunning="{Binding IsKargatzean}"
                           IsVisible="{Binding IsKargatzean}"
                           HorizontalOptions="Center" />

        <Label Grid.Row="1"
               Text="{Binding ErroreMezua}"
               Style="{StaticResource ErroreEtiketaEstiloa}"
               Margin="4,0" />

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding TxostenZainak}">
            <CollectionView.EmptyView>
                <VerticalStackLayout Margin="16" Spacing="12" VerticalOptions="Center">
                    <Label Style="{StaticResource IkonoHandiaEstiloa}"
                           Text="{x:Static kiro:IkonoFontIturria.HutsikIkonoGlifoa}" />
                    <Label Text="Ez dago Zain egoerako txostenik."
                           HorizontalTextAlignment="Center"
                           Style="{StaticResource TestuBigarrenMailaEstiloa}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="datu:TxostenOnarpenLaburpena">
                    <Grid Margin="2,5"
                          MinimumHeightRequest="56">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer NumberOfTapsRequired="1"
                                                  Command="{Binding Source={x:Reference MugimenduakOrriaErreferentzia}, Path=BindingContext.IrekiTxostenXehetasunaCommand}"
                                                  CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>
                        <Border Style="{StaticResource MugimenduSakatagarriTxartelaEstiloa}"
                                InputTransparent="True">
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8"
                                  InputTransparent="True">
                                <VerticalStackLayout Grid.Column="0"
                                                     Spacing="4"
                                                     InputTransparent="True">
                                    <Label InputTransparent="True"
                                           Text="{Binding Helmuga}"
                                           FontAttributes="Bold" />
                                    <Label InputTransparent="True"
                                           Text="{Binding LangileTestua}"
                                           FontSize="13" />
                                    <Label InputTransparent="True"
                                           Text="{Binding GastuenBatuketakoZenbatekoa, StringFormat='Guztira: {0:N2} €'}"
                                           FontSize="13" />
                                    <Label InputTransparent="True"
                                           Text="{Binding Egoera}"
                                           FontSize="12" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1"
                                       Style="{StaticResource MugimenduChevronEtiketaEstiloa}"
                                       Text="{x:Static kiro:IkonoFontIturria.ChevronEskuinaIkonoGlifoa}"
                                       SemanticProperties.Description="Xehetasunak" />
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
