<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kirokuu.ViewModels"
             xmlns:kontrolak="clr-namespace:Kirokuu.Controls"
             x:Class="Kirokuu.Pages.ErabiltzaileXehetasunOrria"
             x:DataType="vm:ErabiltzaileXehetasunViewModel"
             Title="Erabiltzailea">

    <kontrolak:OrriKargatzeEskema IsKargatzean="{Binding IsKargatzean}"
                                  ErroreMezua="{Binding ErroreMezua}">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12">
            <Entry Text="{Binding Izena}" Placeholder="Izena" />
            <Entry Text="{Binding Abizena}" Placeholder="Abizena" />
            <Entry Text="{Binding Abizena2}" Placeholder="Bigarren abizena" />
            <Entry Text="{Binding Dni}" Placeholder="DNI / NAN" />
            <Entry Text="{Binding Posta}"
                   Placeholder="Posta"
                   Keyboard="Email" />
            <Label Text="Sektorea" FontAttributes="Bold" />
            <Picker ItemsSource="{Binding SektoreenAukerak}"
                    ItemDisplayBinding="{Binding Etiketa}"
                    SelectedItem="{Binding HautatutakoSektorea}"
                    Title="Aukeratu sektorea" />

            <Label Text="Kargoa" FontAttributes="Bold" />
            <Picker ItemsSource="{Binding KargoenAukerak}"
                    ItemDisplayBinding="{Binding Etiketa}"
                    SelectedItem="{Binding HautatutakoKargoa}"
                    Title="Aukeratu kargoa" />

            <HorizontalStackLayout Spacing="12">
                <Label Text="Aktibo" VerticalOptions="Center" />
                <Switch IsToggled="{Binding Aktiboa}" />
            </HorizontalStackLayout>

            <Label Text="Pasahitz berria (aukerakoa)"
                   Style="{StaticResource SubHeadline}" />

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                <Entry Grid.Column="0"
                       Text="{Binding PasahitzaBerria}"
                       Placeholder="Utzi hutsik pasahitza mantentzeko"
                       IsPassword="{Binding PasahitzaBerriaMaskaratuta}" />
                <ImageButton Grid.Column="1"
                             Source="{Binding PasahitzaBegiarenIzena}"
                             Command="{Binding AlderantzikatuPasahitzaMaskaCommand}"
                             BackgroundColor="Transparent"
                             WidthRequest="44"
                             HeightRequest="44"
                             Aspect="AspectFit"
                             SemanticProperties.Description="{Binding PasahitzaBegiarenDeskribapena}" />
            </Grid>

            <Button Text="Gorde"
                    Command="{Binding GordeCommand}" />

            <Button Text="Desaktibatu kontua"
                    Command="{Binding DesaktibatuCommand}"
                    Style="{StaticResource BotoiSaioItxiEstiloa}" />
        </VerticalStackLayout>
    </ScrollView>
    </kontrolak:OrriKargatzeEskema>
</ContentPage>
