<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kirokuu.ViewModels"
             x:Class="Kirokuu.Pages.ErabiltzaileXehetasunOrria"
             x:DataType="vm:ErabiltzaileXehetasunViewModel"
             Title="Erabiltzailea">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12">
            <ActivityIndicator IsRunning="{Binding IsKargatzean}"
                               IsVisible="{Binding IsKargatzean}"
                               HorizontalOptions="Center" />

            <Entry Text="{Binding Izena}" Placeholder="Izena" />
            <Entry Text="{Binding Abizena}" Placeholder="Abizena" />
            <Entry Text="{Binding Abizena2}" Placeholder="Bigarren abizena" />
            <Entry Text="{Binding Dni}" Placeholder="DNI / NAN" />
            <Entry Text="{Binding Posta}" Placeholder="Posta" Keyboard="Email" />
            <Entry Text="{Binding Kargoa}" Placeholder="Kargoa" />

            <HorizontalStackLayout Spacing="12">
                <Label Text="Aktibo" VerticalOptions="Center" />
                <Switch IsToggled="{Binding Aktiboa}" />
            </HorizontalStackLayout>

            <Label Text="Pasahitz berria (aukerakoa)"
                   Style="{StaticResource SubHeadline}" />

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                <Entry Grid.Column="0"
                       Text="{Binding PasahitzaBerria}"
                       Placeholder="Utzi hutsik pasahitza mantentzeko"
                       IsPassword="{Binding PasahitzaBerriaMaskaratuta}" />
                <ImageButton Grid.Column="1"
                             Source="{Binding PasahitzaBegiarenIzena}"
                             Command="{Binding AlderantzikatuPasahitzaMaskaCommand}"
                             BackgroundColor="Transparent"
                             WidthRequest="44"
                             HeightRequest="44"
                             Aspect="AspectFit"
                             SemanticProperties.Description="{Binding PasahitzaBegiarenDeskribapena}" />
            </Grid>

            <Label Text="{Binding ErroreMezua}"
                   TextColor="{AppThemeBinding Light=#B00020, Dark=#FF8A80}"
                   HorizontalTextAlignment="Center" />

            <Button Text="Gorde"
                    Command="{Binding GordeCommand}" />

            <Button Text="Desaktibatu kontua"
                    Command="{Binding DesaktibatuCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
