<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kirokuu.ViewModels"
             xmlns:datu="clr-namespace:Kirokuu.DatuEreduak"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:kiro="clr-namespace:Kirokuu"
             xmlns:kontrolak="clr-namespace:Kirokuu.Controls"
             x:Class="Kirokuu.Pages.LangileZerrendaOrria"
             x:Name="LangileZerrendaOrriOrokorra"
             x:DataType="vm:LangileZerrendaViewModel"
             Title="Erabiltzaileak">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Berria"
                     Command="{Binding LangileBerriaIrekiCommand}"
                     Order="Primary"
                     Priority="0" />
    </ContentPage.ToolbarItems>

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing"
                                        Command="{Binding AgertzenDeneanCommand}" />
    </ContentPage.Behaviors>

    <kontrolak:OrriKargatzeEskema IsKargatzean="{Binding IsKargatzean}"
                                  ErroreMezua="{Binding ErroreMezua}">
    <Grid RowDefinitions="Auto,*" Padding="0" RowSpacing="0">
        <SearchBar x:Name="LangileenBilaketa"
                   Grid.Row="0"
                   Placeholder="Bilatu izen, abizen edo posta..."
                   Text="{Binding BilaketaTestua, Mode=TwoWay}"
                   Margin="8,0" />

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Langileak}"
                        Margin="8,0">
            <CollectionView.EmptyView>
                <kontrolak:HutsikIkuspegia Mezua="{Binding HutsaMezua}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="datu:ErabiltzaileLaburpena">
                    <Border Style="{StaticResource TxartelTxartelaEstiloa}" Padding="12,8" Margin="6,4">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={x:Reference LangileZerrendaOrriOrokorra}, Path=BindingContext.IrekiXehetasunaCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4">
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="{Binding Izena}" FontAttributes="Bold" />
                                <Label Text="{Binding Abizena}" FontAttributes="Bold" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding Posta}"
                                   FontSize="13"
                                   Style="{StaticResource TestuBigarrenMailaEstiloa}" />
                            <Label Text="{Binding AktiboTestua}"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
    </kontrolak:OrriKargatzeEskema>
</ContentPage>
