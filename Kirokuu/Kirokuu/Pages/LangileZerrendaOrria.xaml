<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kirokuu.ViewModels"
             xmlns:datu="clr-namespace:Kirokuu.DatuEreduak"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Kirokuu.Pages.LangileZerrendaOrria"
             x:Name="LangileZerrendaOrriOrokorra"
             x:DataType="vm:LangileZerrendaViewModel"
             Title="Erabiltzaileak">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Berria"
                     Command="{Binding LangileBerriaIrekiCommand}"
                     Order="Primary"
                     Priority="0" />
    </ContentPage.ToolbarItems>

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing"
                                        Command="{Binding AgertzenDeneanCommand}" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,Auto,*" Padding="0" RowSpacing="0">
        <ActivityIndicator Grid.Row="0"
                           IsRunning="{Binding IsKargatzean}"
                           IsVisible="{Binding IsKargatzean}"
                           HorizontalOptions="Center"
                           Margin="0,12" />

        <Label Grid.Row="1"
               Text="{Binding ErroreMezua}"
               TextColor="{AppThemeBinding Light=#B00020, Dark=#FF8A80}"
               Margin="16,8"
               HorizontalTextAlignment="Center" />

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Langileak}"
                        Margin="8,0">
            <CollectionView.EmptyView>
                <Label Text="{Binding HutsaMezua}"
                       Padding="24"
                       HorizontalTextAlignment="Center"
                       VerticalOptions="Center" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="datu:ErabiltzaileLaburpena">
                    <Border Padding="12,8" Margin="4,2">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={x:Reference LangileZerrendaOrriOrokorra}, Path=BindingContext.IrekiXehetasunaCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4">
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="{Binding Izena}" FontAttributes="Bold" />
                                <Label Text="{Binding Abizena}" FontAttributes="Bold" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding Posta}"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light=#555555, Dark=#BBBBBB}" />
                            <Label Text="{Binding AktiboTestua}"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
