<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kirokuu.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Kirokuu.Pages.TxartelBerriaOrria"
             x:DataType="vm:TxartelBerriaViewModel"
             Title="Gastu berria">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing"
                                        Command="{Binding AgertzenDeneanCommand}" />
    </ContentPage.Behaviors>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <ActivityIndicator IsRunning="{Binding IsKargatzean}"
                               IsVisible="{Binding IsKargatzean}"
                               HorizontalOptions="Center" />

            <Label Text="{Binding ErroreMezua}"
                   TextColor="{AppThemeBinding Light=#B00020, Dark=#FF8A80}"
                   HorizontalTextAlignment="Center"
                   IsVisible="{Binding ErroreMezua, Converter={toolkit:IsStringNotNullOrEmptyConverter}}" />

            <VerticalStackLayout Spacing="4">
                <Label Text="Kategoria" FontAttributes="Bold" />
                <Picker ItemsSource="{Binding Source={x:Static vm:TxartelBerriaViewModel.KategoriaIzenak}}"
                        SelectedIndex="{Binding HautatutakoKategoriaIndizea}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Zenbatekoa (€)" FontAttributes="Bold" />
                <Entry Text="{Binding ZenbatekoaTestua}"
                       Keyboard="Numeric"
                       Placeholder="0,00"
                       ReturnType="Next" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Data" FontAttributes="Bold" />
                <DatePicker Date="{Binding HautatutakoData}"
                            MaximumDate="{Binding Source={x:Static vm:TxartelBerriaViewModel.GaurkoData}}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Deskribapena" FontAttributes="Bold" />
                <Editor Text="{Binding Deskribapena}"
                        Placeholder="Gastuaren deskribapena idatzi..."
                        MinimumHeightRequest="80"
                        AutoSize="TextChanges" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="Ticket argazkia (aukerakoa)" FontAttributes="Bold" />
                <Button Text="Argazkia hautatu"
                        Command="{Binding HautatuArgazkiaCommand}"
                        BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#424242}"
                        TextColor="{AppThemeBinding Light=#333, Dark=#EEE}"
                        HorizontalOptions="Start"
                        Padding="12,8" />
                <Image Source="{Binding LokalArgazkiBidea}"
                       IsVisible="{Binding ArgazkiHautatua}"
                       HeightRequest="160"
                       Aspect="AspectFit"
                       HorizontalOptions="Start" />
                <Label Text="✓ Argazkia hautatuta"
                       IsVisible="{Binding ArgazkiHautatua}"
                       TextColor="#388E3C"
                       FontSize="13" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,8,0,0">
                <Button Grid.Column="0"
                        Text="Ezeztatu"
                        Command="{Binding EzeztatuCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light=#555, Dark=#AAA}" />
                <Button Grid.Column="1"
                        Text="Gorde"
                        Command="{Binding GordeCommand}"
                        IsEnabled="{Binding IsKargatzean, Converter={toolkit:InvertedBoolConverter}}" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
