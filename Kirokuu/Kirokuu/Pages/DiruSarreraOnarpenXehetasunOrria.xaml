<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kirokuu.ViewModels"
             x:Class="Kirokuu.Pages.DiruSarreraOnarpenXehetasunOrria"
             x:DataType="vm:DiruSarreraOnarpenXehetasunViewModel"
             Title="Diru-sarrera">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <ActivityIndicator IsRunning="{Binding IsKargatzean}"
                               IsVisible="{Binding IsKargatzean}"
                               HorizontalOptions="Center" />

            <Label Text="{Binding Deskribapena}" Style="{StaticResource Headline}" />
            <Label Text="{Binding LangileTestua}" FontSize="14" />
            <Label Text="{Binding Zenbatekoa, StringFormat='Zenbatekoa: {0:N2} €'}" FontSize="14" />
            <Label Text="{Binding DataTestua, StringFormat='Data: {0}'}" FontSize="14" />
            <Label Text="{Binding Egoera, StringFormat='Egoera: {0}'}" FontSize="14" />

            <Label Text="Administratzailearen oharra (ukapenean, aukerakoa)"
                   FontSize="13"
                   IsVisible="{Binding OnarpenEkintzakIkagarri}" />
            <Editor Text="{Binding AdminOharra}"
                    Placeholder="Oharra idatzi ukapenean..."
                    AutoSize="TextChanges"
                    MinimumHeightRequest="80"
                    IsVisible="{Binding OnarpenEkintzakIkagarri}" />

            <Label Text="{Binding ErroreMezua}"
                   TextColor="{AppThemeBinding Light=#B00020, Dark=#FF8A80}"
                   HorizontalTextAlignment="Center" />

            <Button Text="Onartu"
                    Command="{Binding OnartuCommand}"
                    IsVisible="{Binding OnarpenEkintzakIkagarri}" />

            <Button Text="Ukatu"
                    Command="{Binding UkatuCommand}"
                    IsVisible="{Binding OnarpenEkintzakIkagarri}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
