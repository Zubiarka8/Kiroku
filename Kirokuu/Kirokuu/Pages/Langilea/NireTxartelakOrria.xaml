<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kirokuu.ViewModels"
             xmlns:datu="clr-namespace:Kirokuu.DatuEreduak"
             xmlns:kiro="clr-namespace:Kirokuu"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Kirokuu.Pages.NireTxartelakOrria"
             x:Name="NireTxartelakOrriaErreferentzia"
             x:DataType="vm:NireTxartelakViewModel"
             Title="Nire txartelak">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing"
                                        Command="{Binding AgertzenDeneanCommand}" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="16,10,16,0" RowSpacing="0">

        <ActivityIndicator Grid.Row="0"
                           IsRunning="{Binding IsKargatzean}"
                           IsVisible="{Binding IsKargatzean}"
                           HorizontalOptions="Center" />

        <Label Grid.Row="1"
               Text="{Binding ErroreMezua}"
               Style="{StaticResource ErroreEtiketaEstiloa}"
               IsVisible="{Binding ErroreMezua, Converter={toolkit:IsStringNotNullOrEmptyConverter}}"
               Margin="0,4,0,0" />

        <!-- Egoera txipak -->
        <ScrollView Grid.Row="2" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="8" Padding="2,4">
                <Border Style="{StaticResource EgoeraTxipEstiloa}" Stroke="{StaticResource EgoeraZainAtzekoa}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding HautatuFiltroaCommand}" CommandParameter="Zain" />
                    </Border.GestureRecognizers>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding EgoeraFiltroa}" Value="Zain">
                            <Setter Property="BackgroundColor" Value="{StaticResource EgoeraZainAtzekoa}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Style="{StaticResource EgoeraTxipTestuEstiloa}" TextColor="{StaticResource EgoeraZainAtzekoa}"
                           Text="{Binding KopuruZain, StringFormat='Zain ({0})'}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding EgoeraFiltroa}" Value="Zain">
                                <Setter Property="TextColor" Value="White" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>
                <Border Style="{StaticResource EgoeraTxipEstiloa}" Stroke="{StaticResource EgoeraOnartuaAtzekoa}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding HautatuFiltroaCommand}" CommandParameter="Onartua" />
                    </Border.GestureRecognizers>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding EgoeraFiltroa}" Value="Onartua">
                            <Setter Property="BackgroundColor" Value="{StaticResource EgoeraOnartuaAtzekoa}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Style="{StaticResource EgoeraTxipTestuEstiloa}" TextColor="{StaticResource EgoeraOnartuaAtzekoa}"
                           Text="{Binding KopuruOnartua, StringFormat='Onartua ({0})'}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding EgoeraFiltroa}" Value="Onartua">
                                <Setter Property="TextColor" Value="White" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>
                <Border Style="{StaticResource EgoeraTxipEstiloa}" Stroke="{StaticResource EgoeraUkatuaAtzekoa}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding HautatuFiltroaCommand}" CommandParameter="Ukatua" />
                    </Border.GestureRecognizers>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding EgoeraFiltroa}" Value="Ukatua">
                            <Setter Property="BackgroundColor" Value="{StaticResource EgoeraUkatuaAtzekoa}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Style="{StaticResource EgoeraTxipTestuEstiloa}" TextColor="{StaticResource EgoeraUkatuaAtzekoa}"
                           Text="{Binding KopuruUkatua, StringFormat='Ukatua ({0})'}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding EgoeraFiltroa}" Value="Ukatua">
                                <Setter Property="TextColor" Value="White" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>
                <Border Style="{StaticResource EgoeraTxipEstiloa}" Stroke="{StaticResource EgoeraEzeztatuaAtzekoa}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding HautatuFiltroaCommand}" CommandParameter="Ezeztatua" />
                    </Border.GestureRecognizers>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding EgoeraFiltroa}" Value="Ezeztatua">
                            <Setter Property="BackgroundColor" Value="{StaticResource EgoeraEzeztatuaAtzekoa}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Style="{StaticResource EgoeraTxipTestuEstiloa}" TextColor="{StaticResource EgoeraEzeztatuaAtzekoa}"
                           Text="{Binding KopuruEzeztatua, StringFormat='Ezeztatua ({0})'}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding EgoeraFiltroa}" Value="Ezeztatua">
                                <Setter Property="TextColor" Value="White" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>
            </HorizontalStackLayout>
        </ScrollView>

        <RefreshView Grid.Row="3"
                     Command="{Binding AgertzenDeneanCommand}"
                     IsRefreshing="{Binding IsKargatzean}">
            <CollectionView ItemsSource="{Binding Txartelak}"
                            Margin="0,6,0,0"
                            VerticalScrollBarVisibility="Always">
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center"
                                         Spacing="12" Padding="24,56">
                        <Label Style="{StaticResource IkonoHandiaEstiloa}"
                               Text="{x:Static kiro:IkonoFontIturria.HutsikIkonoGlifoa}"
                               HorizontalOptions="Center"
                               SemanticProperties.Description="Hutsik" />
                        <Label Text="Oraindik ez daukazu txartelik."
                               HorizontalTextAlignment="Center"
                               FontAttributes="Bold"
                               FontSize="16" />
                        <Label Text="Sakatu beheko botoia zure lehen gastua sortzeko."
                               HorizontalTextAlignment="Center"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource TestuBigarrenMailaArgia}, Dark={StaticResource TestuBigarrenMailaIluna}}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="datu:TxostenOnarpenLaburpena">
                        <Border Style="{StaticResource TxartelTxartelaEstiloa}"
                                Margin="0,5"
                                Padding="0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={x:Reference NireTxartelakOrriaErreferentzia}, Path=BindingContext.IkusiXehetasunaCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="4,*" ColumnSpacing="0">

                                <!-- Left accent strip colored by status -->
                                <BoxView Grid.Column="0"
                                         CornerRadius="8,0,0,8">
                                    <BoxView.Triggers>
                                        <DataTrigger TargetType="BoxView" Binding="{Binding Egoera}" Value="Zain">
                                            <Setter Property="Color" Value="{StaticResource EgoeraZainAtzekoa}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="BoxView" Binding="{Binding Egoera}" Value="Onartua">
                                            <Setter Property="Color" Value="{StaticResource EgoeraOnartuaAtzekoa}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="BoxView" Binding="{Binding Egoera}" Value="Ukatua">
                                            <Setter Property="Color" Value="{StaticResource EgoeraUkatuaAtzekoa}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="BoxView" Binding="{Binding Egoera}" Value="Ezeztatua">
                                            <Setter Property="Color" Value="{StaticResource EgoeraEzeztatuaAtzekoa}" />
                                        </DataTrigger>
                                    </BoxView.Triggers>
                                </BoxView>

                                <VerticalStackLayout Grid.Column="1" Spacing="0">

                                    <!-- Header: category + status badge -->
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="8"
                                          Padding="12,12,12,4">
                                        <Label Grid.Column="0"
                                               Text="{Binding Helmuga}"
                                               FontAttributes="Bold"
                                               FontSize="15"
                                               VerticalOptions="Center" />
                                        <Border Grid.Column="1"
                                                Padding="10,4"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 12"
                                                VerticalOptions="Center">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding Egoera}" Value="Zain">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource EgoeraZainAtzekoa}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding Egoera}" Value="Onartua">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource EgoeraOnartuaAtzekoa}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding Egoera}" Value="Ukatua">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource EgoeraUkatuaAtzekoa}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding Egoera}" Value="Ezeztatua">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource EgoeraEzeztatuaAtzekoa}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Label Text="{Binding Egoera}"
                                                   Style="{StaticResource EgoeraEtiketaTestuaEstiloa}"
                                                   FontSize="11"
                                                   FontAttributes="Bold" />
                                        </Border>
                                    </Grid>

                                    <!-- Amount (prominent) -->
                                    <Label Text="{Binding GastuenBatuketakoZenbatekoa, StringFormat='{0:N2} €'}"
                                           FontAttributes="Bold"
                                           FontSize="26"
                                           Padding="12,2,12,4"
                                           TextColor="{AppThemeBinding Light={StaticResource EstekaNagusiaArgia}, Dark={StaticResource EstekaNagusiaIluna}}" />

                                    <!-- Date -->
                                    <Label Text="{Binding DataFormateatua}"
                                           FontSize="12"
                                           Padding="12,0,12,10"
                                           TextColor="{AppThemeBinding Light={StaticResource TestuBigarrenMailaArgia}, Dark={StaticResource TestuBigarrenMailaIluna}}"
                                           IsVisible="{Binding DataFormateatua, Converter={toolkit:IsStringNotNullOrEmptyConverter}}" />

                                    <!-- Cancel zone (only if cancellable) -->
                                    <BoxView HeightRequest="1"
                                             IsVisible="{Binding EzeztatuDaiteke}"
                                             Color="{AppThemeBinding Light={StaticResource MugaArinaArgia}, Dark={StaticResource MugaArinaIluna}}" />
                                    <Button Text="Ezeztatu"
                                            IsVisible="{Binding EzeztatuDaiteke}"
                                            Command="{Binding Source={x:Reference NireTxartelakOrriaErreferentzia}, Path=BindingContext.EzeztatuTxartelaCommand}"
                                            CommandParameter="{Binding .}"
                                            Style="{StaticResource BotoiArriskuEstiloa}"
                                            Margin="12,6,12,10"
                                            HeightRequest="40"
                                            FontSize="13" />

                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Button Grid.Row="4"
                Text="Gastu berria gehitu"
                Command="{Binding TxartelBerriaSortuCommand}"
                Margin="0,10,0,16"
                HorizontalOptions="Fill">
            <Button.ImageSource>
                <FontImageSource FontFamily="MaterialIcons"
                                 Glyph="{x:Static kiro:IkonoFontIturria.GehituIkonoGlifoa}"
                                 Size="22"
                                 Color="{StaticResource White}" />
            </Button.ImageSource>
        </Button>

    </Grid>
</ContentPage>
