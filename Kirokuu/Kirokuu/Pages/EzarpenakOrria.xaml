<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kirokuu.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Kirokuu.Pages.EzarpenakOrria"
             x:DataType="vm:EzarpenakViewModel"
             Title="Nire kontua">

    <ContentPage.Resources>
        <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing"
                                        Command="{Binding AgertzenDeneanCommand}" />
    </ContentPage.Behaviors>

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <ActivityIndicator IsRunning="{Binding IsKargatzean}"
                               IsVisible="{Binding IsKargatzean}"
                               HorizontalOptions="Center" />

            <Label Text="Nire kontua"
                   Style="{StaticResource Headline}" />

            <Label Text="Izena" FontAttributes="Bold" />
            <Entry x:Name="IzenaSarrera"
                   Text="{Binding Izena}"
                   Placeholder="Izena" />

            <Label Text="Lehen abizena" FontAttributes="Bold" />
            <Entry x:Name="LehenAbizenaSarrera"
                   Text="{Binding Abizena}"
                   Placeholder="Lehen abizena" />

            <Label Text="Bigarren abizena" FontAttributes="Bold" />
            <Entry x:Name="BigarrenAbizenaSarrera"
                   Text="{Binding Abizena2}"
                   Placeholder="Bigarren abizena" />

            <Label Text="NAN / IFZ" FontAttributes="Bold" />
            <Entry x:Name="NanIfzSarrera"
                   Text="{Binding DNI}"
                   Placeholder="NAN / IFZ" />

            <Label Text="Posta elektronikoa" FontAttributes="Bold" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                <Entry x:Name="PostaSarrera"
                       Grid.Column="0"
                       Text="{Binding Posta}"
                       Placeholder="Posta elektronikoa"
                       Keyboard="Email" />
                <Button x:Name="PostaArrobaTekla"
                        Grid.Column="1"
                        Text="@"
                        Command="{Binding TxertaturikArobaCommand}"
                        FontSize="16"
                        Padding="12,0"
                        WidthRequest="48"
                        HeightRequest="44"
                        VerticalOptions="Center" />
            </Grid>

            <VerticalStackLayout Spacing="8"
                                 IsVisible="{Binding ErakutsiSektoreaKargoHautapenak}">
                <Label Text="Sektorea" FontAttributes="Bold" />
                <Picker x:Name="SektoreaHautapena"
                        ItemsSource="{Binding SektoreenAukerak}"
                        ItemDisplayBinding="{Binding Etiketa}"
                        SelectedItem="{Binding HautatutakoSektorea}"
                        Title="Aukeratu sektorea" />

                <Label Text="Kargoa" FontAttributes="Bold" />
                <Picker x:Name="KargoaHautapena"
                        ItemsSource="{Binding KargoenAukerak}"
                        ItemDisplayBinding="{Binding Etiketa}"
                        SelectedItem="{Binding HautatutakoKargoa}"
                        Title="Aukeratu kargoa" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8"
                                 IsVisible="{Binding ErakutsiSektoreaKargoHautapenak, Converter={StaticResource InvertedBoolConverter}}">
                <Label Text="Sektorea" FontAttributes="Bold" />
                <Label Text="{Binding FinkatutakoSektorearenEtiketa}" />

                <Label Text="Kargoa" FontAttributes="Bold" />
                <Label Text="{Binding FinkatutakoKargoarenEtiketa}" />
            </VerticalStackLayout>

            <Button x:Name="ProfilaGordeTekla"
                    Text="Gorde profila"
                    Command="{Binding ProfilaGordeCommand}"
                    IsEnabled="{Binding ProfilaGordetzen, Converter={StaticResource InvertedBoolConverter}}" />

            <ActivityIndicator IsRunning="{Binding ProfilaGordetzen}"
                               IsVisible="{Binding ProfilaGordetzen}"
                               HorizontalOptions="Center" />

            <VerticalStackLayout Spacing="4">
                <Label Text="Rola" FontAttributes="Bold" />
                <Label Text="{Binding RolTestu}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Erregistro data" FontAttributes="Bold" />
                <Label Text="{Binding SorkuntzaDataTestu}" />
            </VerticalStackLayout>

            <Label Text="{Binding ErroreMezua}"
                   TextColor="{AppThemeBinding Light=#B00020, Dark=#FF8A80}"
                   HorizontalTextAlignment="Center" />

            <BoxView HeightRequest="1"
                     BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                     Margin="0,8" />

            <Label Text="Pasahitza aldatu"
                   FontAttributes="Bold"
                   FontSize="18" />

            <VerticalStackLayout Spacing="8"
                                 IsVisible="{Binding PasahitzaEgiaztatuta, Converter={StaticResource InvertedBoolConverter}}">
                <Label Text="Pasahitza aldatzeko, sartu lehenik zure uneko pasahitza:" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4" VerticalOptions="Center">
                    <Entry x:Name="PasahitzaZaharraSarrera"
                           Grid.Column="0"
                           Text="{Binding PasahitzaZaharra}"
                           Placeholder="Uneko pasahitza"
                           IsPassword="{Binding PasahitzaZaharraMaskaratuta}"
                           SemanticProperties.Hint="Uneko pasahitza" />
                    <ImageButton x:Name="PasahitzaZaharraBegiTekla"
                                 Grid.Column="1"
                                 Source="{Binding PasahitzaZaharraBegiIzena}"
                                 Command="{Binding AlderantzikatuPasahitzaZaharraMaskaCommand}"
                                 BackgroundColor="Transparent"
                                 Padding="8"
                                 WidthRequest="44"
                                 HeightRequest="44"
                                 Aspect="AspectFit"
                                 SemanticProperties.Description="{Binding PasahitzaZaharraBegiDesk}" />
                </Grid>

                <Button x:Name="EgiaztatzuTekla"
                        Text="Egiaztatu"
                        Command="{Binding PasahitzaEgiaztatzCommand}"
                        IsEnabled="{Binding PasahitzaEkintza, Converter={StaticResource InvertedBoolConverter}}" />

                <ActivityIndicator IsRunning="{Binding PasahitzaEkintza}"
                                   IsVisible="{Binding PasahitzaEkintza}"
                                   HorizontalOptions="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8"
                                 IsVisible="{Binding PasahitzaEgiaztatuta}">
                <Label Text="Pasahitza egiaztatu da. Sartu pasahitz berria:"
                       TextColor="#2E7D32" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4" VerticalOptions="Center">
                    <Entry x:Name="PasahitzaBerriaSarrera"
                           Grid.Column="0"
                           Text="{Binding PasahitzaBerria}"
                           Placeholder="Pasahitz berria (8 karaktere gutxienez)"
                           IsPassword="{Binding PasahitzaBerriaMaskaratuta}"
                           SemanticProperties.Hint="Pasahitz berria" />
                    <ImageButton x:Name="PasahitzaBerriaBegiTekla"
                                 Grid.Column="1"
                                 Source="{Binding PasahitzaBerriaBegiIzena}"
                                 Command="{Binding AlderantzikatuPasahitzaBerriaMaskaCommand}"
                                 BackgroundColor="Transparent"
                                 Padding="8"
                                 WidthRequest="44"
                                 HeightRequest="44"
                                 Aspect="AspectFit"
                                 SemanticProperties.Description="{Binding PasahitzaBerriaBegiDesk}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4" VerticalOptions="Center">
                    <Entry x:Name="PasahitzaBerriaBerretsiSarrera"
                           Grid.Column="0"
                           Text="{Binding PasahitzaBerriaBerretsi}"
                           Placeholder="Berretsi pasahitz berria"
                           IsPassword="{Binding PasahitzaBerriaBerretsiMaskaratuta}"
                           SemanticProperties.Hint="Pasahitz berria berretsi" />
                    <ImageButton x:Name="PasahitzaBerriaBerretsiBegiTekla"
                                 Grid.Column="1"
                                 Source="{Binding PasahitzaBerriaBerretsiBegiIzena}"
                                 Command="{Binding AlderantzikatuPasahitzaBerriaBerretsiMaskaCommand}"
                                 BackgroundColor="Transparent"
                                 Padding="8"
                                 WidthRequest="44"
                                 HeightRequest="44"
                                 Aspect="AspectFit"
                                 SemanticProperties.Description="{Binding PasahitzaBerriaBerretsiBegiDesk}" />
                </Grid>

                <Button x:Name="PasahitzaAldatuTekla"
                        Text="Pasahitza aldatu"
                        Command="{Binding PasahitzaAldatuCommand}"
                        IsEnabled="{Binding PasahitzaEkintza, Converter={StaticResource InvertedBoolConverter}}" />

                <ActivityIndicator IsRunning="{Binding PasahitzaEkintza}"
                                   IsVisible="{Binding PasahitzaEkintza}"
                                   HorizontalOptions="Center" />
            </VerticalStackLayout>

            <Label Text="{Binding PasahitzaErroreMezua}"
                   TextColor="{AppThemeBinding Light=#B00020, Dark=#FF8A80}"
                   HorizontalTextAlignment="Center"
                   IsVisible="{Binding PasahitzaErroreDago}" />

            <BoxView HeightRequest="1"
                     BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                     Margin="0,8" />

            <Button x:Name="SaioaItxiTekla"
                    Text="Saioa itxi"
                    Command="{Binding SaioaItxiCommand}"
                    BackgroundColor="{AppThemeBinding Light=#B00020, Dark=#FF8A80}"
                    SemanticProperties.Hint="Saioa itxi eta hasierara itzuli" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
