<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kirokuu.ViewModels"
             x:Class="Kirokuu.MainPage"
             x:DataType="vm:MainPageViewModel"
             Title="Credenciales">

    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="20">

            <ActivityIndicator
                IsRunning="{Binding IsKargatzean}"
                IsVisible="{Binding IsKargatzean}"
                HorizontalOptions="Center" />

            <Label
                Text="{Binding EgoeraMezua}"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center" />

            <Label
                Text="{Binding XehetasunMezua}"
                FontSize="14"
                TextColor="{AppThemeBinding Light=#555555, Dark=#BBBBBB}"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
