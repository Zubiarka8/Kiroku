    <Style x:Key="SaioSarreraEntryEstiloa" TargetType="Entry">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Margin" Value="12,12,4,12" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="SaioIkonoLaguntzaTeklaEstiloa" TargetType="ImageButton">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="WidthRequest" Value="48" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Aspect" Value="AspectFit" />
    </Style>

    <Style x:Key="MugimenduSakatagarriTxartelaEstiloa" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource MugimenduTxartelaMugaArgia}, Dark={StaticResource MugimenduTxartelaMugaIluna}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource MugimenduTxartelaAzalaArgia}, Dark={StaticResource MugimenduTxartelaAzalaIluna}}" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style x:Key="MugimenduChevronEtiketaEstiloa" TargetType="Label">
        <Setter Property="FontFamily" Value="MaterialIcons" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="Opacity" Value="0.85" />
        <Setter Property="InputTransparent" Value="True" />
    </Style>

    <!-- Chip base estiloa egoeraren araberako iragazkientzat. Hautatu gabe: gris arina; hautatuta: chip bakoitzak BackgroundColor eta TextColor sobrescribitzen ditu DataTrigger bidez. -->
    <Style x:Key="EgoeraTxipEstiloa" TargetType="Border">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="StrokeShape" Value="RoundRectangle 18" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource MugaArinaArgia}, Dark={StaticResource MugaArinaIluna}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="MinimumHeightRequest" Value="36" />
    </Style>

    <Style x:Key="EgoeraTxipTestuEstiloa" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="InputTransparent" Value="True" />
    </Style>

</ResourceDictionary>
